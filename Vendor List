    useRecordCreate({
      fields:
        vendorFields,

      onError: (error) => {
        toast.error(
          error?.message ||
            "Unable to add vendor."
        );
      },
    });

  const updateVendor =
    useRecordUpdate({
      fields:
        vendorFields,

      onError: (error) => {
        toast.error(
          error?.message ||
            "Unable to update vendor."
        );
      },
    });


  /* =======================================================
     LISTS / FILTERS
  ======================================================= */

  const existingLists =
    useMemo(() => {
      const lists =
        uniqueSorted(
          vendorRecords.map(
            (record) =>
              text(
                record.fields
                  ?.vendorList
              )
          )
        );

      return lists.length
        ? lists
        : [DEFAULT_LIST_NAME];
    }, [vendorRecords]);

  const activeList =
    selectedList ||
    existingLists[0] ||
    DEFAULT_LIST_NAME;

  const categories =
    useMemo(() => {
      return uniqueSorted(
        vendorRecords
          .filter(
            (record) =>
              text(
                record.fields
                  ?.vendorList
              ) === activeList
          )
          .map((record) =>
            text(
              record.fields
                ?.category
            )
          )
      );
    }, [
      vendorRecords,
      activeList,
    ]);

  const filteredVendors =
    useMemo(() => {
      const query =
        normalize(search);

      return vendorRecords.filter(
        (record) => {
          const f =
            record.fields || {};

          const listMatch =
            text(
              f.vendorList
            ) === activeList;

          if (!listMatch) {
            return false;
          }

          const categoryMatch =
            categoryFilter ===
              "All" ||
            text(
              f.category
            ) === categoryFilter;

          if (!categoryMatch) {
            return false;
          }

          if (!query) {
            return true;
          }

          const haystack = [
            f.vendorName,
            f.category,
            f.serviceArea,
            f.basicOfferings,
            f.contactName,
            f.contactEmail,
          ]
            .map((item) =>
              normalize(item)
            )
            .join(" ");

          return haystack.includes(
            query
          );
        }
      );
    }, [
      vendorRecords,
      activeList,
      categoryFilter,
      search,
    ]);


