                        form.vendorName
                      }
                      onChange={(event) =>
                        changeForm(
                          "vendorName",
                          event.target.value
                        )
                      }
                      placeholder="Vendor or company name"
                    />
                  </Field>

                  <Field
                    label="Vendor List"
                    required
                    helper="Examples: Preferred Vendors, Approved Vendors, Required Vendors."
                  >
                    <Input
                      value={
                        form.vendorList
                      }
                      onChange={(event) =>
                        changeForm(
                          "vendorList",
                          event.target.value
                        )
                      }
                      placeholder="Preferred Vendors"
                    />
                  </Field>


                  <Field
                    label="Category"
                    required
                    helper="Use the common category name you want users to recognize."
                  >
                    <Input
                      value={
                        form.category
                      }
                      onChange={(event) =>
                        changeForm(
                          "category",
                          event.target.value
                        )
                      }
                      placeholder="Catering, Photographer, Bar / Beverage..."
                      list="vendor-category-options"
                    />

                    <datalist id="vendor-category-options">
                      {CATEGORY_SUGGESTIONS.map(
                        (category) => (
                          <option
                            key={category}
                            value={category}
                          />
                        )
                      )}
                    </datalist>
                  </Field>

                  <Field
                    label="Service Area"
                    helper="Keep this simple for now: city, region, county, or statewide."
                  >
                    <Input
                      value={
                        form.serviceArea
                      }
                      onChange={(event) =>
                        changeForm(
                          "serviceArea",
                          event.target.value
                        )
                      }
                      placeholder="St. George, Southern Utah, Statewide..."
                    />
                  </Field>


                  <div className="md:col-span-2">
                    <Field
                      label="Basic Offerings"
                      helper="One offering per line works best. Example: Full-service catering, buffet, plated dinner, staffing."
                    >
                      <Textarea
                        value={
                          form.basicOfferings
                        }
                        onChange={(event) =>
                          changeForm(
                            "basicOfferings",
                            event.target.value
                          )
                        }
                        placeholder={"Full-service catering\nBuffet service\nPlated dinner\nEvent staffing"}
                        className="min-h-[110px]"
                      />
                    </Field>
                  </div>


                  <Field label="Contact Name">
                    <Input
                      value={
                        form.contactName
                      }
                      onChange={(event) =>
                        changeForm(
                          "contactName",
                          event.target.value
                        )
                      }
                      placeholder="Primary contact"
                    />
                  </Field>

                  <Field label="Contact Email">
                    <Input
                      type="email"
                      value={
                        form.contactEmail
                      }
                      onChange={(event) =>
                        changeForm(
                          "contactEmail",
                          event.target.value
                        )
                      }
                      placeholder="hello@vendor.com"
                    />
                  </Field>

                  <Field label="Contact Phone">
                    <Input
                      value={
                        form.contactPhone
                      }
                      onChange={(event) =>
                        changeForm(
                          "contactPhone",
                          event.target.value
                        )
                      }
                      placeholder="801-555-1234"
                    />
                  </Field>

                  <Field label="Website">
                    <Input
                      value={
                        form.website
                      }
                      onChange={(event) =>
                        changeForm(
                          "website",
                          event.target.value
                        )
                      }
                      placeholder="https://vendor.com"
                    />
                  </Field>


                  <div className="md:col-span-2">
                    <Field
                      label="Insurance / COI Link"
                      helper="For this MVP, use a URL field so the form stays reliable. Later we can convert this to a true file-upload field when the database schema is ready."
                    >
                      <div className="relative">
                        <ShieldCheck className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#968C7E]" />

                        <Input
                          value={
                            form.insuranceFile
                          }
                          onChange={(event) =>
                            changeForm(
                              "insuranceFile",
                              event.target.value
                            )
                          }
                          placeholder="https://.../certificate-of-insurance.pdf"
                          className="pl-10"
                        />
                      </div>
                    </Field>
                  </div>


                  <div className="md:col-span-2">
                    <Field
                      label="Notes"
                      helper="Anything venue staff or CRUE should know about using this vendor."
                    >
                      <Textarea
                        value={
                          form.notes
                        }
                        onChange={(event) =>
                          changeForm(
                            "notes",
                            event.target.value
                          )
                        }
                        placeholder="Internal notes, restrictions, relationship history, special pricing..."
                        className="min-h-[100px]"
                      />
                    </Field>
                  </div>
                </div>


                <div className="mt-7 flex flex-col-reverse gap-2 border-t border-[#EEE9E0] pt-5 sm:flex-row sm:justify-end">
                  <Button
                    type="button"
                    variant="ghost"
                    onClick={() =>
                      setShowForm(false)
                    }
                  >
                    Cancel
                  </Button>

                  <Button
                    type="button"
                    onClick={saveVendor}
                    disabled={saving}
                    className="bg-[#1A1916] text-white hover:bg-[#34312C]"
                  >
                    {saving ? (
                      <>
                        <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                        Saving...
                      </>
                    ) : editingRecordId ? (
                      <>
                        <CheckCircle2 className="mr-2 h-4 w-4" />
                        Save Vendor
                      </>
                    ) : (
                      <>
                        <Plus className="mr-2 h-4 w-4" />
                        Add Vendor
                      </>
                    )}
                  </Button>
                </div>
              </div>
            </section>
          )}


          {/* LIST PICKER */}
          <section className="mt-5 rounded-[24px] border border-[#E5E0D7] bg-white p-5 shadow-sm sm:p-6">
            <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
              <div>
                <p className="text-[10px] font-bold uppercase tracking-[0.13em] text-[#A07943]">
                  Vendor Lists
                </p>

                <h2 className="mt-1 text-xl font-semibold text-[#1E1B17]">
                  Choose a list
                </h2>
              </div>

              <Button
                type="button"
                variant="outline"
                onClick={() =>
                  setShowNewListInput(
                    (current) => !current
                  )
                }
              >
                <CirclePlus className="mr-2 h-4 w-4" />
                New List
              </Button>
            </div>

            {showNewListInput && (
              <div className="mt-4 flex flex-col gap-2 rounded-xl border border-[#E5E0D7] bg-[#FAF8F4] p-4 sm:flex-row">
                <Input
                  value={
                    newListName
                  }
                  onChange={(event) =>
                    setNewListName(
                      event.target.value
                    )
                  }
                  placeholder="Example: Required Vendors"
                />

                <Button
                  type="button"
                  onClick={createNewList}
                  className="bg-[#1A1916] text-white hover:bg-[#34312C]"
                >
                  Create List
                </Button>
              </div>
            )}

            <div className="mt-5 flex gap-2 overflow-x-auto pb-1">
              {existingLists.map(
                (listName) => {
                  const active =
                    listName ===
                    activeList;

                  const count =
                    vendorRecords.filter(
                      (record) =>
                        text(
                          record.fields
                            ?.vendorList
                        ) === listName
                    ).length;

                  return (
                    <button
                      key={listName}
                      type="button"
                      onClick={() => {
                        setSelectedList(
                          listName
                        );
                        setCategoryFilter(
                          "All"
                        );
                      }}
                      className={`min-w-max rounded-xl border px-4 py-3 text-left transition ${
                        active
                          ? "border-[#1A1916] bg-[#1A1916] text-white"
                          : "border-[#E4DFD6] bg-[#FAF8F4] text-[#5F574D] hover:border-[#BDB4A6]"
                      }`}
                    >
                      <p className="text-sm font-semibold">
                        {listName}
                      </p>

                      <p
                        className={`mt-0.5 text-xs ${
                          active
                            ? "text-white/50"
                            : "text-[#948A7D]"
                        }`}
                      >
                        {count}{" "}
                        {count === 1
                          ? "vendor"
                          : "vendors"}
                      </p>
                    </button>
                  );
                }
              )}
            </div>
          </section>


          {/* SEARCH / FILTER */}
          <section className="mt-4 rounded-[22px] border border-[#E5E0D7] bg-white p-4 shadow-sm">
            <div className="grid gap-3 lg:grid-cols-[1fr_auto_auto]">
              <div className="relative">
                <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#958C80]" />

                <Input
                  value={search}
                  onChange={(event) =>
                    setSearch(
                      event.target.value
                    )
                  }
                  placeholder="Search vendors, offerings, service area..."
                  className="pl-10"
                />
              </div>

              <select
                value={
                  categoryFilter
                }
                onChange={(event) =>
                  setCategoryFilter(
                    event.target.value
                  )
                }
                className="h-10 rounded-md border border-input bg-background px-3 text-sm"
              >
                <option value="All">
                  All Categories
                </option>

                {categories.map(
                  (category) => (
                    <option
                      key={category}
                      value={category}
                    >
                      {category}
                    </option>
                  )
                )}
              </select>

              <Button
                type="button"
                onClick={openAddVendor}
                className="bg-[#D2B06F] text-[#1A1916] hover:bg-[#E0C58F]"
              >
                <Plus className="mr-2 h-4 w-4" />
                Add Vendor
              </Button>
            </div>
          </section>


          {/* CONTENT HEADER */}
          <div className="mt-6 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p className="text-[10px] font-bold uppercase tracking-[0.13em] text-[#A07943]">
                {activeList}
              </p>

              <h2 className="mt-1 text-2xl font-semibold tracking-[-0.02em] text-[#1E1B17]">
                {filteredVendors.length}{" "}
                {filteredVendors.length === 1
                  ? "vendor"
                  : "vendors"}
              </h2>
            </div>

            <p className="text-xs text-[#8A8175]">
              Venue ID:{" "}
              <span className="font-mono">
                {venueRecordId}
              </span>
            </p>
          </div>


          {/* VENDOR GRID */}
          <div className="mt-4">
            {vendorStatus ===
              "pending" ||
            vendorFetching ? (
              <div className="rounded-[24px] border border-[#E5E0D7] bg-white p-12 text-center">
                <Loader2 className="mx-auto h-6 w-6 animate-spin text-[#857358]" />

                <p className="mt-3 text-sm text-[#766D62]">
                  Loading vendor list...
                </p>
              </div>
            ) : filteredVendors.length ===
              0 ? (
              <EmptyState
                onAdd={openAddVendor}
                listName={
                  activeList
                }
              />
            ) : (
              <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                {filteredVendors.map(
                  (record) => (
                    <VendorCard
                      key={record.id}
                      record={record}
                      onEdit={
                        openEditVendor
                      }
                    />
                  )
                )}
              </div>
            )}
          </div>


          {/* MVP NOTE */}
          <section className="mt-6 rounded-[22px] border border-[#DED5C7] bg-[#F1E9DB] p-5">
            <div className="flex items-start gap-3">
              <Sparkles className="mt-0.5 h-5 w-5 shrink-0 text-[#8C6735]" />

              <div>
                <p className="font-semibold text-[#2A241C]">
                  Built to grow without overbuilding the database.
                </p>

                <p className="mt-1 text-sm leading-6 text-[#6F6455]">
                  Start with list, category, contact, service area, offerings, insurance link, and notes. Later you can add pricing, preferred status, compliance expiration, availability, venue-specific rates, contracts, and lead-routing rules without redesigning the whole page.
                </p>
              </div>
            </div>
          </section>

        </div>
      </div>
    </div>
  );
}
