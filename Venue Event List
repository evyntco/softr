export default function Block() {
    const venueRecordId = getVenueRecordId();
    const venueNameParam = getVenueNameParam();
    const eventRecordId = getEventRecordId();

    /*
     * Venue mode wins when both are present — "venue info portal" sets
     * recordId and venueRecordId to the same value (the venue's id), so
     * checking venueRecordId first is what keeps that link from being
     * misread as an event id.
     */
    const mode = venueRecordId ? "venue" : eventRecordId ? "event" : "preview";
    const previewMode = mode === "preview";

    const { data, status, error } = useRecords({
        from: ds.status,
        select: statusFields,
        where:
            mode === "venue"
                ? q.text("venueRecordId").is(venueRecordId)
                : mode === "event"
                    ? q.text("eventRecordId").is(eventRecordId)
                    : undefined,
        count: mode === "venue" ? 200 : 50,
    });

    const records = useMemo(
        () => (previewMode ? PREVIEW_RECORDS : flattenPages(data)),
        [previewMode, data]
    );

    const sortedRecords = useMemo(
        () =>
            [...records].sort((a, b) => {
                if (mode === "venue") {
                    const dateDiff =
                        (parseDate(a?.fields?.eventDate)?.getTime() ?? Infinity) -
                        (parseDate(b?.fields?.eventDate)?.getTime() ?? Infinity);
                    if (dateDiff !== 0) return dateDiff;
                }
                return (
                    text(a?.fields?.vendorType).localeCompare(text(b?.fields?.vendorType)) ||
                    text(a?.fields?.vendorName).localeCompare(text(b?.fields?.vendorName))
                );
            }),
        [records, mode]
    );

    /*
     * Venue mode: one status row per (event, vendor), so group by event
     * for display. There's no separate Event Name field on this table
     * today, so the event date stands in as the group label.
     */
    const eventGroups = useMemo(() => {
        if (mode !== "venue") return [];

        const groups = new Map();
        for (const record of sortedRecords) {
            const key = text(record?.fields?.eventRecordId) || "unknown";
            if (!groups.has(key)) {
                groups.set(key, {
                    eventRecordId: key,
                    eventDate: text(record?.fields?.eventDate),
                    records: [],
                });
            }
            groups.get(key).records.push(record);
        }
        return Array.from(groups.values());
    }, [sortedRecords, mode]);

    const eventDate = text(sortedRecords[0]?.fields?.eventDate);
    const venueName =
        venueNameParam || text(sortedRecords[0]?.fields?.venueName);

    const overall = useMemo(() => {
        const totals = sortedRecords.reduce(
            (accumulator, record) => {
                const progress = vendorProgress(record.fields || {});
                accumulator.complete += progress.complete;
                accumulator.total += progress.total;
                return accumulator;
            },
            { complete: 0, total: 0 }
        );

        return {
            ...totals,
            percent: totals.total
                ? Math.round((totals.complete / totals.total) * 100)
                : 0,
        };
    }, [sortedRecords]);

    const warningCount = sortedRecords.filter(
        (record) => attentionState(record.fields || {}).tone === "warning"
    ).length;

    if (!previewMode && status === "pending") {
        return (
            <div className="min-h-[480px] bg-[#F5F3EE] p-8">
                <div className="mx-auto max-w-lg rounded-2xl border bg-white p-10 text-center shadow-sm">
                    <Clock3 className="mx-auto h-6 w-6 animate-pulse text-[#A07943]" />
                    <p className="mt-3 text-sm font-medium text-[#6F675D]">
                        Loading event status...
                    </p>
                </div>
            </div>
        );
    }

    if (!previewMode && status === "error") {
        return (
            <div className="min-h-[480px] bg-[#F5F3EE] p-8">
                <div className="mx-auto max-w-lg rounded-2xl border border-red-200 bg-white p-8 shadow-sm">
                    <AlertTriangle className="h-6 w-6 text-red-700" />
                    <h2 className="mt-3 text-xl font-semibold">Unable to load event status</h2>
                    <p className="mt-2 text-sm text-red-700">
                        {error?.message ||
                            "Check the Status datasource, Event Record ID field, and page recordId."}
                    </p>
                </div>
            </div>
        );
    }

    return (
        <div className="min-h-screen bg-[#F5F3EE] text-[#1E1B17]">
            <div className="container py-6 sm:py-8">
                <div className="content mx-auto max-w-6xl">
                    <section className="overflow-hidden rounded-[28px] bg-[#191815] text-white shadow-lg">
                        <div className="p-6 sm:p-8">
                            <div className="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
                                <div>
                                    <div className="flex flex-wrap items-center gap-2">
                                        <p className="text-[10px] font-bold uppercase tracking-[0.16em] text-[#D3B270]">
                                            Event Delivery Status
                                        </p>

                                        {previewMode && (
                                            <Badge className="border-0 bg-white/10 text-white hover:bg-white/10">
                                                Preview Data
                                            </Badge>
                                        )}
                                    </div>

                                    <h1 className="mt-2 text-3xl font-semibold tracking-[-0.035em] sm:text-4xl">
                                        {venueName || "Event Vendor Status"}
                                    </h1>

                                    <div className="mt-3 flex flex-wrap items-center gap-4 text-sm text-white/60">
                                        {mode === "venue" ? (
                                            <>
                                                <span className="inline-flex items-center gap-2">
                                                    <CalendarDays className="h-4 w-4" />
                                                    {eventGroups.length} event{eventGroups.length === 1 ? "" : "s"}
                                                </span>
                                                <span>
                                                    {sortedRecords.length} vendor{sortedRecords.length === 1 ? "" : "s"} total
                                                </span>
                                            </>
                                        ) : (
                                            <>
                                                {eventDate && (
                                                    <span className="inline-flex items-center gap-2">
                                                        <CalendarDays className="h-4 w-4" />
                                                        {formatDate(eventDate)}
                                                    </span>
                                                )}
                                                {eventDate && <span>{eventCountdown(eventDate)}</span>}
                                                <span>
                                                    {sortedRecords.length} vendor{sortedRecords.length === 1 ? "" : "s"}
                                                </span>
                                            </>
                                        )}
                                    </div>
                                </div>

                                <div className="grid min-w-[280px] grid-cols-2 gap-2">
                                    <div className="rounded-xl border border-white/10 bg-white/[0.05] p-3">
                                        <p className="text-[9px] uppercase tracking-[0.08em] text-white/40">
                                            Overall Progress
                                        </p>
                                        <p className="mt-1 text-2xl font-semibold">{overall.percent}%</p>
                                    </div>

                                    <div className="rounded-xl border border-white/10 bg-white/[0.05] p-3">
                                        <p className="text-[9px] uppercase tracking-[0.08em] text-white/40">
                                            Needs Attention
                                        </p>
                                        <p className="mt-1 text-2xl font-semibold">{warningCount}</p>
                                    </div>
                                </div>
                            </div>

                            <div className="mt-6 h-2 overflow-hidden rounded-full bg-white/10">
                                <div
                                    className="h-full rounded-full bg-[#D2AD69]"
                                    style={{ width: `${overall.percent}%` }}
                                />
                            </div>
                        </div>

                        <div className="h-1.5 bg-[#B88A4C]" />
                    </section>

                    <section className="mt-4 rounded-2xl border border-[#E3DED5] bg-white px-5 py-4 shadow-sm">
                        <div className="flex items-start gap-3">
                            <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-emerald-700" />
                            <div>
                                <p className="text-sm font-semibold">
                                    {mode === "venue"
                                        ? "Every event at this venue. Every vendor's status."
                                        : "One event. One view of every vendor."}
                                </p>
                                <p className="mt-1 text-xs leading-5 text-[#81786D]">
                                    Each vendor moves through its own booking, preparation, and event-day milestones. The next step shown on each card is the most important action currently outstanding for that vendor.
                                </p>
                            </div>
                        </div>
                    </section>

                    {sortedRecords.length === 0 ? (
                        <section className="mt-5 rounded-[24px] border border-[#E3DED5] bg-white p-10 text-center shadow-sm">
                            <Clock3 className="mx-auto h-7 w-7 text-[#A07943]" />
                            <h2 className="mt-3 text-xl font-semibold">No vendor status records yet</h2>
                            <p className="mx-auto mt-2 max-w-xl text-sm leading-6 text-[#81786D]">
                                {mode === "venue"
                                    ? "No vendor status records reference this venue yet."
                                    : "Create one Status record for each vendor attached to this event and set its Event Record ID to the current event record."}
                            </p>
                        </section>
                    ) : mode === "venue" ? (
                        <div className="mt-5 space-y-8">
                            {eventGroups.map((group) => (
                                <div key={group.eventRecordId}>
                                    <div className="mb-3 flex items-center gap-3">
                                        <CalendarDays className="h-4 w-4 text-[#A07943]" />
                                        <p className="text-sm font-semibold text-[#332E28]">
                                            {group.eventDate
                                                ? formatDate(group.eventDate)
                                                : "Event date not set"}
                                        </p>
                                        <span className="text-xs text-[#91887D]">
                                            {group.records.length} vendor{group.records.length === 1 ? "" : "s"}
                                        </span>
                                    </div>
                                    <div className="space-y-5">
                                        {group.records.map((record) => (
                                            <VendorCard key={record.id} record={record} />
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <div className="mt-5 space-y-5">
                            {sortedRecords.map((record) => (
                                <VendorCard key={record.id} record={record} />
                            ))}
                        </div>
                    )}
                </div>
            </div>
        </div>
    );
}
