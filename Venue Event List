function getUrlParams() {
    if (typeof window === "undefined") return new URLSearchParams();
    return new URLSearchParams(window.location.search);
}

function getVenueRecordId() {
    return (getUrlParams().get("venueRecordId") || "").trim();
}

function getVenueNameParam() {
    return (getUrlParams().get("venueName") || "").trim();
}

function getEventRecordId() {
    const params = getUrlParams();
    return (
        params.get("eventRecordId") ||
        params.get("recordId") ||
        ""
    ).trim();
}

function flattenPages(data) {
    return data?.pages?.flatMap((page) => page.items || []) || [];
}

function text(value) {
    if (value === null || value === undefined) return "";
    if (typeof value === "string" || typeof value === "number") return String(value);
    if (typeof value === "boolean") return value ? "Yes" : "No";
    if (Array.isArray(value)) return value.map(text).filter(Boolean).join(", ");
    if (typeof value === "object") {
        return String(value.label || value.name || value.value || "");
    }
    return "";
}

function toBoolean(value) {
    if (value === true) return true;
    if (value === false) return false;
    return ["yes", "true", "1", "required"].includes(text(value).trim().toLowerCase());
}

function parseDate(value) {
    const raw = text(value).trim();
    if (!raw) return null;
    const date = new Date(raw);
    return Number.isNaN(date.getTime()) ? null : date;
}

function formatDate(value) {
    const date = parseDate(value);
    if (!date) return "";
    return date.toLocaleDateString(undefined, {
        month: "short",
        day: "numeric",
        year: "numeric",
    });
}

function formatTimestamp(value) {
    const date = parseDate(value);
    if (!date) return "";
    return date.toLocaleString(undefined, {
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
    });
}

function startOfDay(date) {
    return new Date(date.getFullYear(), date.getMonth(), date.getDate());
}

function daysUntil(value) {
    const eventDate = parseDate(value);
    if (!eventDate) return null;
    const today = startOfDay(new Date());
    const target = startOfDay(eventDate);
    return Math.ceil((target - today) / 86400000);
}

function eventCountdown(value) {
    const days = daysUntil(value);
    if (days === null) return "Event date not set";
    if (days > 1) return `${days} days until event`;
    if (days === 1) return "Tomorrow";
    if (days === 0) return "Event is today";
    return `${Math.abs(days)} day${Math.abs(days) === 1 ? "" : "s"} past event`;
}

function applicableMilestones(fields) {
    return MILESTONE_GROUPS.flatMap((group) =>
        group.milestones
            .filter((milestone) => !milestone.condition || milestone.condition(fields))
            .map((milestone) => ({ ...milestone, group: group.label, groupId: group.id }))
    );
}

function vendorProgress(fields) {
    const milestones = applicableMilestones(fields);
    const complete = milestones.filter((milestone) =>
        Boolean(text(fields[milestone.key]).trim())
    ).length;

    return {
        complete,
        total: milestones.length,
        percent: milestones.length
            ? Math.round((complete / milestones.length) * 100)
            : 0,
    };
}

function vendorStatus(fields) {
    const milestones = applicableMilestones(fields);
    if (!milestones.length) {
        return { label: "Not Started", next: "", currentIndex: -1 };
    }

    const nextIndex = milestones.findIndex(
        (milestone) => !text(fields[milestone.key]).trim()
    );

    if (nextIndex === -1) {
        return {
            label: "Complete",
            next: "Complete",
            currentIndex: milestones.length,
        };
    }

    if (nextIndex === 0) {
        return {
            label: "Waiting to Start",
            next: milestones[0].label,
            currentIndex: 0,
        };
    }

    return {
        label: milestones[nextIndex - 1].label,
        next: milestones[nextIndex].label,
        currentIndex: nextIndex,
    };
}

function attentionState(fields) {
    const days = daysUntil(fields.eventDate);
    const insuranceNeeded = toBoolean(fields.requiresInsurance);
    const insuranceDone = Boolean(text(fields.vendorInsurancePrepared).trim());

    if (
        days !== null &&
        days <= 7 &&
        days >= 0 &&
        insuranceNeeded &&
        !insuranceDone
    ) {
        return { tone: "warning", label: "Insurance review needed" };
    }

    const progress = vendorProgress(fields);
    if (progress.percent === 100) {
        return { tone: "complete", label: "Ready" };
    }

    return { tone: "active", label: "In Progress" };
}

