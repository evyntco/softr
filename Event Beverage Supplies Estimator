        id: `mocktail-version-${cocktail.id}`,
        sourceCocktailId: cocktail.id,
        name: `NA ${cocktail.name}`,
        originalName: cocktail.name,
        servings,
        defaultServings,
        ingredients,
        omittedAlcohol,
        shoppingListMixers: cocktail.shoppingListMixers || "",
      };
    });
