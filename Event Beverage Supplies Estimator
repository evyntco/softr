      standardRows.push({ category: "Equipment", item: "Water Dispensers", quantity: waterDispensers, purchaseUnit: "units", packageSize: "—", needed: "Water dispensers for guest hydration", includeInPO: true });
    }

    if (results.cocktailServings > 0) {
      standardRows.push({ category: "Supplies", item: "Cups (Cocktails)", quantity: results.cocktailServings, purchaseUnit: "cups", packageSize: "—", needed: "One cup per cocktail serving", includeInPO: true });
    }

    if (results.napkinsNeeded > 0) {
      standardRows.push({ category: "Supplies", item: "Napkins", quantity: results.napkinsNeeded, purchaseUnit: "napkins", packageSize: "—", needed: "One napkin per drinking guest", includeInPO: true });
    }

    if (results.strawsNeeded > 0) {
      standardRows.push({ category: "Supplies", item: "Straws", quantity: results.strawsNeeded, purchaseUnit: "straws", packageSize: "—", needed: "Two straws per cocktail", includeInPO: true });
    }

    const poRows = standardRows.filter((row) => row.quantity > 0);
    const referenceRows = referenceOnlyRows.filter((row) => row.quantity > 0);

    return {
      // Keep `rows` as the PO-only collection because the receiving page reads this field.
      rows: poRows,
      standardRows: poRows,
      referenceOnlyRows: referenceRows,
      reviewOnlyRows: referenceRows,
      configInfo,
      serviceProviderConfirmed,
      purchaseOrderConfirmationRequired,
      isNonAlcoholicEvent,
      beerProcurement,
      wineProcurement,
      cocktailProcurement,
    };
  }

  function buildPurchaseOrderDestination() {
    const base = purchaseOrderFormLink.destination || "/purchase-order-form";
    const payload = buildPurchaseOrderPayload();
    const params = new URLSearchParams();
    params.set("po", JSON.stringify(payload.rows));
    if (payload.configInfo) {
      params.set("configId", payload.configInfo.configId || "");
      params.set("projectName", payload.configInfo.projectName || "");
      params.set("reservationId", payload.configInfo.reservationId || "");
      params.set("eventDate", payload.configInfo.eventDate || "");
      params.set("eventHostName", payload.configInfo.eventHostName || "");
    }
    return `${base}${base.includes("?") ? "&" : "?"}${params.toString()}`;
  }

  async function copyPurchaseOrder() {
    try {
      await navigator.clipboard.writeText(purchaseOrderText);
      setCopied(true);
      window.setTimeout(() => setCopied(false), 1800);
    } catch {
      setCopied(false);
    }
  }

  function downloadPurchaseOrderCsv() {
    const payload = buildPurchaseOrderPayload();
    const rows = [
      ["Category", "Item", "Quantity", "Purchase Unit", "Package Size", "Needed"],
      ...payload.rows.map((r) => [r.category, r.item, r.quantity, r.purchaseUnit, r.packageSize, r.needed]),
    ];
    // Add config info header if available
    if (payload.configInfo) {
      rows.unshift(["Project Name", payload.configInfo.projectName || "", "Reservation ID", payload.configInfo.reservationId || "", "Event Date", payload.configInfo.eventDate || ""]);
      rows.unshift(["BEVERAGE CONFIGURATION"]);
    }
    const csv = rows.map((row) => row.map(escapeCsv).join(",")).join("\n");
    const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.download = "beverage-purchase-order.csv";
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();
    URL.revokeObjectURL(url);
  }

