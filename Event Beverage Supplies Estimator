function normalizeIngredientName(value) {
  return String(value || "")
    .toLowerCase()
    .replace(/coca[-\s]?cola/g, "coke")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function fieldText(value) {
  if (value == null) return "";
  if (Array.isArray(value)) {
    return value.map((item) => fieldText(item)).filter(Boolean).join(", ");
  }
  if (typeof value === "object") {
    return String(value.label || value.name || value.value || "");
  }
  return String(value);
}

function isSodaBarCategory(value) {
  const normalized = normalizeIngredientName(fieldText(value));
  return normalized.includes("soda bar") || normalized.includes("dirty soda");
}

function isAlcoholIngredient(ingredient) {
  const category = normalizeIngredientName(ingredient?.category);
  return category.includes("liquor") || category.includes("alcohol") || category.includes("spirit");
}

function toNumber(value, fallback = 0) {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : fallback;
}

function nonNegative(value, fallback = 0) {
  return Math.max(0, toNumber(value, fallback));
}

function safeCeil(value) {
  return Math.ceil(Math.max(0, value) - 1e-9);
}

function formatNumber(value, digits = 0) {
  return Number(value || 0).toLocaleString(undefined, { maximumFractionDigits: digits });
}

function normalizeUnit(unit, fallback = "oz") {
  const cleaned = String(unit || fallback).trim().toLowerCase().replace(/\./g, "");
  if (cleaned === "fl oz" || cleaned === "floz" || cleaned === "fluid ounce") return "oz";
  if (cleaned === "millilitre" || cleaned === "millilitres") return "ml";
  if (cleaned === "litre" || cleaned === "litres") return "l";
  return cleaned || fallback;
}

function singularize(word, fallback = "unit") {
  const value = String(word || fallback || "unit").trim();
  if (!value) return fallback || "unit";
  const lower = value.toLowerCase();
  if (lower.endsWith("ies")) return `${value.slice(0, -3)}y`;
  if (lower.endsWith("s") && !lower.endsWith("ss")) return value.slice(0, -1);
  return value;
}

function volumeToMl(amount, unit) {
  const normalized = normalizeUnit(unit, "oz");
  const multiplier = VOLUME_TO_ML[normalized];
  return multiplier ? nonNegative(amount) * multiplier : null;
}

function amountToBase(amount, unit) {
  const normalized = normalizeUnit(unit, "oz");
  if (COUNT_UNITS.has(normalized)) {
    return { dimension: "count", baseAmount: nonNegative(amount) };
  }
  const ml = volumeToMl(amount, normalized);
  if (ml == null) return null;
  return { dimension: "volume", baseAmount: ml };
}

function formatBaseAmount(baseAmount, dimension) {
  if (dimension === "count") return `${formatNumber(baseAmount, 1)} each`;
  if (baseAmount >= 1000) return `${formatNumber(baseAmount / 1000, 2)} L`;
  return `${formatNumber(baseAmount, 0)} mL`;
}

function defaultPurchaseFields(category, recipeUnit) {
  const normalizedCategory = normalizeIngredientName(category);
  const normalizedRecipeUnit = normalizeUnit(recipeUnit, "oz");

  if (normalizedCategory.includes("liquor") || normalizedCategory.includes("alcohol") || normalizedCategory.includes("spirit")) {
    return {
      packageSize: DEFAULT_LIQUOR_BOTTLE_ML,
      packageUnit: "ml",
      purchaseUnit: "bottle",
      price: 0,
    };
  }

  if (COUNT_UNITS.has(normalizedRecipeUnit) || normalizedCategory.includes("garnish")) {
    return {
      packageSize: 1,
      packageUnit: "each",
      purchaseUnit: "each",
      price: 0,
    };
  }

  return {
    packageSize: DEFAULT_MIXER_PACKAGE_SIZE,
    packageUnit: DEFAULT_MIXER_PACKAGE_UNIT,
    purchaseUnit: DEFAULT_MIXER_PURCHASE_UNIT,
    price: 0,
  };
}

function withPurchaseDefaults(ingredient) {
  const defaults = defaultPurchaseFields(ingredient.category, ingredient.unit);
  return {
    ...ingredient,
    packageSize: ingredient.packageSize ?? defaults.packageSize,
    packageUnit: ingredient.packageUnit ?? defaults.packageUnit,
    purchaseUnit: ingredient.purchaseUnit ?? defaults.purchaseUnit,
    price: ingredient.price ?? defaults.price,
  };
}

function escapeCsv(value) {
  const stringValue = String(value ?? "");
  return `"${stringValue.replace(/"/g, '""')}"`;
}

function generateId() {
  return `${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;
}

