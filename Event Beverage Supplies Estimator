                                                  onChange={(e) => updateMocktailFormIngredient(ingredient.id, "category", e.target.value)}
                                                  className="w-full rounded-md border bg-background px-3 py-2 text-sm"
                                                >
                                                  <option value="mixer">Mixer</option>
                                                  <option value="garnish">Garnish</option>
                                                  <option value="na-spirit">NA Spirit</option>
                                                  <option value="supply">Supply</option>
                                                </select>
                                              </label>
                                              <Button variant="ghost" size="icon" onClick={() => removeMocktailIngredientFromForm(ingredient.id)}>
                                                <Trash2 className="h-4 w-4 text-destructive" />
                                              </Button>
                                            </div>
                                          ))}
                                        </div>
                                      )}

                                      <div className="rounded-lg border p-3 space-y-3">
                                        <div className="grid md:grid-cols-2 gap-3">
                                          <label className="block space-y-1">
                                            <span className="text-xs font-medium">Ingredient Name</span>
                                            <Input
                                              value={newMocktailIngredient.name}
                                              onChange={(e) => setNewMocktailIngredient((prev) => ({ ...prev, name: e.target.value }))}
                                              placeholder="e.g., Lime Juice"
                                            />
                                          </label>
                                          <label className="block space-y-1">
                                            <span className="text-xs font-medium">Category</span>
                                            <select
                                              value={newMocktailIngredient.category}
                                              onChange={(e) => setNewMocktailIngredient((prev) => ({ ...prev, category: e.target.value }))}
                                              className="w-full rounded-md border bg-background px-3 py-2 text-sm"
                                            >
                                              <option value="mixer">Mixer</option>
                                              <option value="garnish">Garnish</option>
                                              <option value="na-spirit">NA Spirit</option>
                                              <option value="supply">Supply</option>
                                            </select>
                                          </label>
                                          <label className="block space-y-1">
                                            <span className="text-xs font-medium">Quantity Per Serving</span>
                                            <Input
                                              value={newMocktailIngredient.quantity}
                                              onChange={(e) => setNewMocktailIngredient((prev) => ({ ...prev, quantity: e.target.value }))}
                                              placeholder="e.g., 2"
                                            />
                                          </label>
                                          <label className="block space-y-1">
                                            <span className="text-xs font-medium">Unit</span>
                                            <Input
                                              value={newMocktailIngredient.unit}
                                              onChange={(e) => setNewMocktailIngredient((prev) => ({ ...prev, unit: e.target.value }))}
                                              placeholder="oz, mL, each..."
                                            />
                                          </label>
                                        </div>
                                        <Button variant="outline" size="sm" className="w-full" onClick={addMocktailIngredientToForm}>
                                          <Plus className="h-3.5 w-3.5 mr-1" />
                                          Add Ingredient
                                        </Button>
                                      </div>
                                    </div>
                                  </div>

                                  <DialogFooter>
                                    <Button variant="outline" onClick={() => { setMocktailDialogOpen(false); resetMocktailForm(); }}>
                                      Cancel
                                    </Button>
                                    <Button onClick={saveCustomMocktail}>
                                      {editingMocktailId ? "Update Mocktail" : "Save Mocktail"}
                                    </Button>
                                  </DialogFooter>
                                </DialogContent>
                              </Dialog>
                            </div>
                          )}
                        </div>
                      )}
                    </div>
                  )}
                </div>

                {/* Share Summary */}
                {allSelectedCocktails.length > 0 && (
                  <div className={`rounded-lg p-3 text-sm ${totalCocktailShare === 100 ? "bg-green-500/10 text-green-700" : "bg-amber-500/10 text-amber-700"}`}>
                    Total cocktail share: <strong>{totalCocktailShare}%</strong>
                    {totalCocktailShare !== 100 && <span className="ml-2">(will be normalized to 100%)</span>}
                  </div>
                )}
              </div>
            </section>

            <SectionCard step="4" eyebrow="Ice & Cups" title="Calculate ice and cups" description="Estimate bagged ice and cups needed for your event.">
              <div className="space-y-4">
                <div className="flex items-center gap-3">
                  <Checkbox
                    id="ice-machine"
                    checked={hasIceMachine}
                    onCheckedChange={(checked) => setHasIceMachine(checked === true)}
                  />
                  <Label htmlFor="ice-machine" className="text-sm font-medium cursor-pointer">
                    Ice machine available at venue
                  </Label>
                </div>
                {!hasIceMachine && (
                  <div className="grid grid-cols-2 gap-3">
                    <MetricBox label="Ice Needed" value={`${formatNumber(results.iceLbsNeeded, 1)} lbs`} />
                    <MetricBox label="Bags to Buy" value={`${results.iceBags} bags`} />
                  </div>
                )}
                {hasIceMachine && (
                  <div className="rounded-lg bg-muted/40 p-4 text-sm text-muted-foreground">
                    Ice machine available — no bagged ice needed.
                  </div>
                )}
                <p className="text-xs text-muted-foreground">Based on 0.25 lbs per guest per hour, 16 lbs per bag.</p>

                <div className="border-t pt-4 mt-4">
                  <div className="grid grid-cols-3 gap-3">
                    <MetricBox label="Cups for Cocktails" value={`${formatNumber(results.cocktailServings)} cups`} />
                    <MetricBox label="Napkins" value={`${formatNumber(results.napkinsNeeded)} napkins`} />
                    <MetricBox label="Straws" value={`${formatNumber(results.strawsNeeded)} straws`} />
                  </div>
                  <p className="text-xs text-muted-foreground mt-2">One cup per cocktail serving · 1 napkin per drinking guest · 2 straws per cocktail.</p>
                </div>
              </div>
            </SectionCard>

            <SectionCard step="4b" eyebrow="Extra Supplies" title="Additional supplies & equipment" description="Add extra cups, napkins, straws, table/linens, and water dispensers for your event.">
              <div className="space-y-4">
                <div className="flex items-start gap-3">
                  <Checkbox
                    id="add-extra-supplies"
                    checked={addExtraSupplies}
                    onCheckedChange={(checked) => setAddExtraSupplies(checked === true)}
                  />
                  <div className="flex-1">
                    <Label htmlFor="add-extra-supplies" className="text-sm font-semibold cursor-pointer">
                      Add extra cups, napkins, straws for water service, wine service, etc.
                    </Label>
                    <p className="text-xs text-muted-foreground mt-1">
                      Enable this to manually add extra supplies beyond the automatically calculated amounts.
                    </p>
                  </div>
                </div>

                {addExtraSupplies && (
                  <div className="space-y-4 border-t pt-4">
                    <div className="grid md:grid-cols-3 gap-4">
                      <NumberInput label="Extra Cups" value={extraCups} min={0} step={1} onChange={setExtraCups} />
                      <NumberInput label="Extra Napkins" value={extraNapkins} min={0} step={1} onChange={setExtraNapkins} />
                      <NumberInput label="Extra Straws" value={extraStraws} min={0} step={1} onChange={setExtraStraws} />
                    </div>
                  </div>
                )}

                <div className="border-t pt-4 space-y-4">
                  <div className="flex items-start gap-3">
                    <Checkbox
                      id="add-table-linens"
                      checked={addTableLinens}
                      onCheckedChange={(checked) => setAddTableLinens(checked === true)}
                    />
                    <div className="flex-1">
                      <Label htmlFor="add-table-linens" className="text-sm font-semibold cursor-pointer">
                        Add Tables / Linens
                      </Label>
                      <p className="text-xs text-muted-foreground mt-1">
                        Include table and linen requirements for your event setup.
                      </p>
                    </div>
                  </div>
                  {addTableLinens && (
                    <div className="pl-8">
                      <NumberInput label="Tables / Linens" value={tableLinens} min={0} step={1} onChange={setTableLinens} />
                    </div>
                  )}

                  <div className="flex items-start gap-3">
                    <Checkbox
                      id="add-water-dispensers"
                      checked={addWaterDispensers}
                      onCheckedChange={(checked) => setAddWaterDispensers(checked === true)}
                    />
                    <div className="flex-1">
                      <Label htmlFor="add-water-dispensers" className="text-sm font-semibold cursor-pointer">
                        Add Water Dispensers
                      </Label>
                      <p className="text-xs text-muted-foreground mt-1">
                        Include water dispensers for guest hydration.
                      </p>
                    </div>
                  </div>
                  {addWaterDispensers && (
                    <div className="pl-8">
                      <NumberInput label="Water Dispensers" value={waterDispensers} min={0} step={1} onChange={setWaterDispensers} />
                    </div>
                  )}
                </div>
              </div>
            </SectionCard>


          </div>

          <aside className="lg:col-span-1">
            <div className="sticky top-6 space-y-6">
              <div className="rounded-xl border-2 border-primary bg-card text-card-foreground shadow-sm">
                <div className="p-6 border-b">
                  <span className="inline-flex rounded-full bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground">Purchase Order</span>
                  <h2 className="text-2xl font-semibold mt-3">Beverage Shopping List</h2>
                  <div className="text-4xl font-bold text-primary mt-2">{formatNumber(results.plannedDrinks)}</div>
                  <p className="text-xs text-muted-foreground mt-1">Planned servings including buffer.</p>
                </div>

                <div className="p-6 space-y-5">
                  <div className="rounded-xl border bg-muted/30 p-4 space-y-3">
                    <div>
                      <h3 className="font-semibold text-sm">Alcohol Procurement</h3>
                      <p className="text-xs text-muted-foreground mt-1">
                        All calculated totals stay visible here for reference. Only confirmed Service Staff alcohol is sent to the purchase order.
                      </p>
                    </div>
                    <PurchaseRow
                      name="Beer"
                      quantity={procurementStatus(beerProcurement).label}
                      detail={procurementStatus(beerProcurement).detail}
                    />
                    <PurchaseRow
                      name="Wine"
                      quantity={procurementStatus(wineProcurement).label}
                      detail={procurementStatus(wineProcurement).detail}
                    />
                    <PurchaseRow
                      name="Cocktail Alcohol"
                      quantity={procurementStatus(cocktailProcurement).label}
                      detail={procurementStatus(cocktailProcurement).detail}
                    />
                  </div>

                  <ResultBox
                    title="Beer"
                    amount={`${formatNumber(results.beerCases)} cases`}
                    detail={`${formatNumber(results.beerServings)} units needed · ${procurementStatus(beerProcurement).label}${beerProcurement === "Host" ? " · reference only" : beerProcurement === "Service Staff" && !serviceProviderConfirmed ? " · confirmation required" : ""}`}
                  />
                  <ResultBox
                    title="Wine"
                    amount={`${formatNumber(results.wineBottles)} bottles`}
                    detail={`${formatNumber(results.wineServings)} pours needed · ${procurementStatus(wineProcurement).label}${wineProcurement === "Host" ? " · reference only" : wineProcurement === "Service Staff" && !serviceProviderConfirmed ? " · confirmation required" : ""}`}
                  />
                  <ResultBox title="Ice" amount={hasIceMachine ? "Machine available" : `${results.iceBags} bags`} detail={hasIceMachine ? "No bagged ice needed" : `${formatNumber(results.iceLbsNeeded, 1)} lbs needed`} />

                  {cocktailBreakdown.length > 0 && (
                    <>
                      <PurchaseList title="Cocktail Production">
                        {cocktailBreakdown.map((cocktail) => (
                          <PurchaseRow
                            key={cocktail.id}
                            name={cocktail.name}
                            quantity={`${cocktail.servings} servings`}
                            detail={`${cocktail.share}% entered share · normalized across selected cocktails`}
                          />
                        ))}
                      </PurchaseList>

                      <PurchaseList title="Bulk Cocktail Ingredients">
                        {cocktailBulkPurchaseRows.length === 0 ? (
                          <div className="text-xs text-muted-foreground">No cocktail ingredients calculated.</div>
                        ) : (
                          cocktailBulkPurchaseRows.map((item) => (
                            <PurchaseRow
                              key={item.id}
                              name={`${item.attention ? "⚠ " : ""}${item.item}`}
                              quantity={`${item.quantity} ${item.purchaseUnit}${item.quantity === 1 ? "" : "s"}`}
                              detail={`${item.packageSize} each · ${item.needed}${item.category === "Liquor" ? ` · ${procurementStatus(cocktailProcurement).label}${cocktailProcurement === "Host" ? " · reference only" : cocktailProcurement === "Service Staff" && !serviceProviderConfirmed ? " · confirmation required" : ""}` : ""}`}
                            />
                          ))
                        )}
                      </PurchaseList>
                    </>
                  )}

                  {addOpenBarMixers && (
                    <PurchaseList title="Open Bar Mixers">
                      {allOpenBarPurchaseRows.length === 0 ? (
                        <div className="text-xs text-muted-foreground">
                          Selected cocktails already cover the required open-bar items.
                        </div>
                      ) : (
                        allOpenBarPurchaseRows.map((item) => (
                          <PurchaseRow
                            key={item.id}
                            name={item.item}
                            quantity={`${item.quantity} ${item.purchaseUnit}${item.quantity === 1 ? "" : "s"}`}
                            detail={`${item.packageSize || "—"} · ${item.needed || ""}`}
                          />
                        ))
                      )}
                    </PurchaseList>
                  )}

                  {hasNonAlcoholicAddOn && (
                    <PurchaseList title="Non-Alcoholic Add-Ons">
                      <PurchaseRow
                        name="Guests to Provide Beverages For"
                        quantity={`${formatNumber(beverageAddOnGuests)} guests`}
                        detail={[
                          addSodaOnly ? "Soda Only" : null,
                          addDirtySodaBar ? "Dirty Soda Bar" : null,
                          addMocktailAddOn ? "Mocktail" : null,
                        ].filter(Boolean).join(" · ")}
                      />

                      {addSodaOnly && sodaOnlyPurchaseRows.map((item) => (
                        <PurchaseRow
                          key={item.id}
                          name={`${item.attention ? "⚠ " : ""}${item.item}`}
                          quantity={`${item.quantity} ${item.purchaseUnit}${item.quantity === 1 ? "" : "s"}`}
                          detail={item.needed}
                        />
                      ))}

                      {addDirtySodaBar && selectedSodaBarRecipes.map((recipe) => (
                        <PurchaseRow
                          key={`recipe-${recipe.id}`}
                          name={recipe.name}
                          quantity={`${recipe.servings} servings`}
                          detail="Dirty Soda menu recipe"
                        />
                      ))}

                      {addDirtySodaBar && [...dirtySodaRecipePurchaseRows, ...manualDirtySodaPurchaseRows].map((item) => (
                        <PurchaseRow
                          key={item.id}
                          name={`${item.attention ? "⚠ " : ""}${item.item}`}
                          quantity={`${item.quantity} ${item.purchaseUnit}`}
                          detail={item.needed}
                        />
                      ))}

                      {addMocktailAddOn && (
                        <>
                          <PurchaseRow
                            name={mocktailMode === "selected-cocktails" ? "Mocktail Method" : mocktailMode === "custom" ? "Mocktail Method" : "⚠ Mocktail Method"}
                            quantity={mocktailMode === "selected-cocktails" ? "NA Cocktails" : mocktailMode === "custom" ? "Custom" : "Required"}
                            detail={mocktailMode === "selected-cocktails"
                              ? "Non-alcoholic versions of selected cocktails"
                              : mocktailMode === "custom"
                                ? "Custom manual mocktail recipes"
                                : "Choose a mocktail method before fulfillment"}
                          />

                          {activeMocktailRecipes.map((recipe) => (
                            <PurchaseRow
                              key={`mocktail-recipe-${recipe.id}`}
                              name={recipe.name}
                              quantity={`${formatNumber(recipe.servings)} servings`}
                              detail={mocktailMode === "selected-cocktails"
                                ? `NA version${recipe.omittedAlcohol?.length ? ` · alcohol omitted: ${recipe.omittedAlcohol.join(", ")}` : ""}`
                                : "Custom mocktail recipe"}
                            />
                          ))}

                          {mocktailPurchaseRows.map((item) => (
                            <PurchaseRow
                              key={item.id}
                              name={`${item.attention ? "⚠ " : ""}${item.item}`}
                              quantity={`${item.quantity} ${item.purchaseUnit}`}
                              detail={item.needed}
                            />
                          ))}
                        </>
                      )}
                    </PurchaseList>
                  )}



                  <PurchaseList title="Supplies Summary">
                    <PurchaseRow name="Cups (Cocktails)" quantity={`${formatNumber(results.cocktailServings)} cups`} detail="One cup per cocktail serving" />
                    <PurchaseRow name="Napkins" quantity={`${formatNumber(results.napkinsNeeded)} napkins`} detail="One napkin per drinking guest" />
                    <PurchaseRow name="Straws" quantity={`${formatNumber(results.strawsNeeded)} straws`} detail="Two straws per cocktail" />
                    {addExtraSupplies && (
                      <>
                        {extraCups > 0 && <PurchaseRow name="Extra Cups" quantity={`${formatNumber(extraCups)} cups`} detail="Additional cups for water/wine service" />}
                        {extraNapkins > 0 && <PurchaseRow name="Extra Napkins" quantity={`${formatNumber(extraNapkins)} napkins`} detail="Additional napkins" />}
                        {extraStraws > 0 && <PurchaseRow name="Extra Straws" quantity={`${formatNumber(extraStraws)} straws`} detail="Additional straws" />}
                      </>
                    )}
                    {addTableLinens && tableLinens > 0 && <PurchaseRow name="Tables / Linens" quantity={`${formatNumber(tableLinens)} sets`} detail="Table and linen sets" />}
                    {addWaterDispensers && waterDispensers > 0 && <PurchaseRow name="Water Dispensers" quantity={`${formatNumber(waterDispensers)} units`} detail="Water dispensers for guest hydration" />}
                  </PurchaseList>

                  <button type="button" onClick={copyPurchaseOrder} className="w-full rounded-md bg-primary px-4 py-3 text-sm font-semibold text-primary-foreground hover:opacity-90">{copied ? "Copied" : "Copy Purchase Order"}</button>
                  <button type="button" onClick={downloadPurchaseOrderCsv} className="w-full rounded-md border bg-background px-4 py-3 text-sm font-semibold hover:bg-muted">Download Purchase Order CSV</button>

                  {!selectedConfig ? (
                    <div className="rounded-lg border-2 border-amber-500/40 bg-amber-500/5 p-4 text-center">
                      <p className="text-sm font-semibold text-amber-700 mb-1">Beverage Configuration Required</p>
                      <p className="text-xs text-muted-foreground">
                        Search and select a Beverage Configuration above before reviewing and saving the purchase order.
                      </p>
                    </div>
                  ) : purchaseOrderConfirmationRequired ? (
                    <div className="space-y-3">
                      <div className="rounded-lg border-2 border-amber-500/40 bg-amber-500/5 p-4 text-center">
                        <p className="text-sm font-semibold text-amber-700 mb-1">Service Staff Confirmation Required</p>
                        <p className="text-xs text-muted-foreground">
                          One or more alcohol categories are assigned to Service Staff. Confirm the service provider is supplying the alcohol in Step 2 before these items can be sent to the purchase order.
                        </p>
                      </div>
                      <button
                        type="button"
                        disabled
                        className="w-full rounded-md bg-muted px-4 py-3 text-sm font-semibold text-muted-foreground cursor-not-allowed"
                      >
                        Confirm Staff Procurement to Continue
                      </button>
                    </div>
                  ) : (
                    <NavigationAction
                      navigation={{
                        ...purchaseOrderFormLink,
                        destination: buildPurchaseOrderDestination(),
                      }}
                      recordId={selectedConfig?.id || undefined}
                    >
                      <button
                        type="button"
                        className="w-full rounded-md bg-primary px-4 py-3 text-sm font-semibold text-primary-foreground hover:opacity-90"
                      >
                        Review + Save Purchase Order
                      </button>
                    </NavigationAction>
                  )}
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  );
}

function SectionCard({ step, eyebrow, title, description, children }) {
  return (
    <section className="rounded-xl border bg-card text-card-foreground shadow-sm">
      <div className="p-6 border-b">
        <div className="flex items-center gap-2 text-sm text-primary font-semibold">
          <span className="rounded-full bg-primary text-primary-foreground w-6 h-6 flex items-center justify-center text-xs">{step}</span>
          {eyebrow}
        </div>
        <h2 className="text-2xl font-semibold tracking-tight mt-2">{title}</h2>
        <p className="text-sm text-muted-foreground mt-2">{description}</p>
      </div>
      <div className="p-6">{children}</div>
    </section>
  );
}

function NumberInput({ label, value, onChange, min = 0, step = 1 }) {
  return (
    <label className="block space-y-2">
      <span className="text-xs font-medium">{label}</span>
      <input type="number" min={min} step={step} value={value} onChange={(event) => onChange(toNumber(event.target.value, 0))} className="w-full rounded-md border bg-background px-3 py-2 text-sm" />
    </label>
  );
}

function BulkUnitSelect({ label, value, onChange }) {
  return (
    <label className="block space-y-2">
      <span className="text-xs font-medium">{label}</span>
      <select
        value={normalizeUnit(value, "oz")}
        onChange={(event) => onChange(event.target.value)}
        className="w-full rounded-md border bg-background px-3 py-2 text-sm"
      >
        <option value="oz">oz</option>
        <option value="ml">mL</option>
        <option value="l">L</option>
        <option value="cup">cup</option>
        <option value="pt">pint</option>
        <option value="qt">quart</option>
        <option value="gal">gallon</option>
        <option value="each">each</option>
      </select>
    </label>
  );
}

function PercentBox({ label, value, onChange }) {
  return (
    <div className="rounded-xl border-2 p-4">
      <div className="flex items-center justify-between gap-3 mb-3">
        <span className="font-semibold text-sm">{label}</span>
        <span className="rounded-full bg-muted px-2.5 py-1 text-xs font-semibold">{value}%</span>
      </div>
      <NumberInput label={`${label} Percentage`} value={value} min={0} step={1} onChange={onChange} />
    </div>
  );
}

function MetricBox({ label, value }) {
  return (
    <div className="rounded-lg bg-muted p-4">
      <div className="text-xs text-muted-foreground mb-1">{label}</div>
      <div className="text-2xl font-semibold">{value}</div>
    </div>
  );
}

function ResultBox({ title, amount, detail }) {
  return (
    <div className="rounded-xl border p-4">
      <h3 className="font-semibold text-sm">{title}</h3>
      <div className="text-2xl font-semibold mt-2">{amount}</div>
      <p className="text-xs text-muted-foreground mt-1">{detail}</p>
    </div>
  );
}

function PurchaseList({ title, children }) {
  return (
    <div className="pt-4 border-t">
      <h3 className="font-semibold text-sm mb-3">{title}</h3>
      <div className="space-y-3">{children}</div>
    </div>
  );
}

function ProcurementDropdown({ label, value, onChange }) {
  return (
    <label className="block space-y-2">
      <span className="text-xs font-medium">{label}</span>
      <select
        value={value}
        onChange={(e) => onChange(e.target.value)}
        className="w-full rounded-md border bg-background px-3 py-2 text-sm"
      >
        <option value="Host">Host</option>
        <option value="Service Staff">Service Staff</option>
        <option value="None (Non Alcoholic Event)">None (Non Alcoholic Event)</option>
      </select>
    </label>
  );
}

function PurchaseRow({ name, quantity, detail }) {
  return (
    <div>
      <div className="flex justify-between gap-3 text-sm">
        <span className="font-medium">{name}</span>
        <span className="font-semibold text-right">{quantity}</span>
      </div>
      <p className="text-xs text-muted-foreground mt-1">{detail}</p>
    </div>
  );
}
