  const mocktailVersionsOfSelectedCocktails = useMemo(() => {
    if (!addMocktailAddOn || mocktailMode !== "selected-cocktails" || allSelectedCocktails.length === 0) return [];

    const totalServings = Math.max(0, Math.round(nonNegative(beverageAddOnGuests)));
    const positiveShares = allSelectedCocktails.map((cocktail) => nonNegative(cocktail.share));
    const shareTotal = positiveShares.reduce((sum, share) => sum + share, 0);
    const weights = shareTotal > 0
      ? positiveShares.map((share) => share / shareTotal)
      : allSelectedCocktails.map(() => 1 / allSelectedCocktails.length);

    const raw = weights.map((weight) => totalServings * weight);
    const base = raw.map((value) => Math.floor(value));
    let remainder = Math.max(0, totalServings - base.reduce((sum, value) => sum + value, 0));
    const ranked = raw
      .map((value, index) => ({ index, fraction: value - Math.floor(value) }))
      .sort((a, b) => b.fraction - a.fraction);

    for (let i = 0; i < ranked.length && remainder > 0; i += 1) {
      base[ranked[i].index] += 1;
      remainder -= 1;
    }

    return allSelectedCocktails.map((cocktail, index) => {
      const defaultServings = base[index] || 0;
      const servings = mocktailCocktailServingsOverrides[cocktail.id] !== undefined
        ? nonNegative(mocktailCocktailServingsOverrides[cocktail.id])
        : defaultServings;

      const ingredients = (cocktail.ingredients || [])
