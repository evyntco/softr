                          {/* ALCOHOL TYPES */}

                          {alcoholAllowed &&
                            alcoholTypes && (

                              <div className="mt-3 flex items-start gap-2 rounded-xl bg-[#faf8f3] p-3 text-sm text-[#5f574d]">

                                <Wine className="mt-[2px] h-4 w-4 shrink-0 text-[#a37b3e]" />

                                <div>
                                  <div className="text-xs font-bold text-[#817668]">
                                    Alcohol Types
                                  </div>

                                  <div className="mt-1">
                                    {alcoholTypes}
                                  </div>
                                </div>

                              </div>
                            )}

                          {/* APPROVED CATERERS */}

                          {approvedCaterers && (

                            <div className="mt-3 flex items-start gap-2 rounded-xl bg-[#faf8f3] p-3 text-sm text-[#5f574d]">

                              <UtensilsCrossed className="mt-[2px] h-4 w-4 shrink-0 text-[#a37b3e]" />

                              <div>
                                <div className="text-xs font-bold text-[#817668]">
                                  Approved Caterers
                                </div>

                                <div className="mt-1">
                                  {approvedCaterers}
                                </div>
                              </div>

                            </div>
                          )}

                          {/* ---------------------------
                              VENUE AMENITIES
                          --------------------------- */}

                          <div className="my-5 border-t border-[#eee9df]" />

                          <div className="mb-3 text-[11px] font-extrabold uppercase tracking-wider text-[#817668]">
                            Service Amenities
                          </div>

                          <div className="flex flex-wrap gap-2">

                            {barSetup && (
                              <Badge variant="outline">
                                <Wine className="mr-1 h-3 w-3" />
                                Bar Setup
                              </Badge>
                            )}

                            {iceMachine && (
                              <Badge variant="outline">
                                <Snowflake className="mr-1 h-3 w-3" />
                                Ice Machine
                              </Badge>
                            )}

                            {waterAccess && (
                              <Badge variant="outline">
                                <Droplets className="mr-1 h-3 w-3" />
                                Water Access
                              </Badge>
                            )}

                            {stageAvailable && (
                              <Badge variant="outline">
                                <Theater className="mr-1 h-3 w-3" />
                                Stage Available
                              </Badge>
                            )}

                          </div>

                          {/* ---------------------------
                              SERVICE REQUIREMENTS
                          --------------------------- */}

                          {(minBartenders ||
                            serveTime) && (

                            <div className="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">

                              {minBartenders && (
                                <div className="rounded-xl bg-[#f8f6f1] px-4 py-3">

                                  <div className="text-[10px] font-bold uppercase tracking-wide text-[#83796c]">
                                    Minimum Bartenders
                                  </div>

                                  <div className="mt-1 text-lg font-semibold text-[#211f1b]">
                                    {minBartenders}
                                  </div>

                                </div>
                              )}

                              {serveTime && (
                                <div className="rounded-xl bg-[#f8f6f1] px-4 py-3">

                                  <div className="flex items-center gap-1 text-[10px] font-bold uppercase tracking-wide text-[#83796c]">
                                    <Clock className="h-3 w-3" />
                                    Service Time Limit
                                  </div>

                                  <div className="mt-1 text-lg font-semibold text-[#211f1b]">
                                    {serveTime} hours
                                  </div>

                                </div>
                              )}

                            </div>
                          )}

                          {/* ---------------------------
                              VIEW PROFILE
                          --------------------------- */}

                          <div className="mt-5 border-t border-[#eee9df] pt-4">

                            <Button
                              asChild
                              className="w-full bg-[#111111] text-white hover:bg-[#292929]"
                            >

                              <NavigationAction
                                navigation={
                                  venueProfileNavigation
                                }
                                recordId={venue.id}
                              >

                                <span className="flex items-center justify-center">

                                  View Venue Profile

                                  <ChevronRight className="ml-2 h-4 w-4" />

                                </span>

                              </NavigationAction>

                            </Button>

                          </div>

                        </div>

                      </div>
                    );
                  }
                )}

              </div>
            )}

          {/* =================================================
              LOAD MORE
          ================================================= */}

          {hasNextPage &&
            status === "success" && (

              <div className="mt-6 flex justify-center">

                <Button
                  variant="outline"
                  className="border-[#d8d1c2] bg-white"
                  onClick={() =>
                    fetchNextPage()
                  }
                  disabled={
                    isFetchingNextPage
                  }
                >

                  {isFetchingNextPage ? (
                    <>
                      <RefreshCw className="mr-2 h-4 w-4 animate-spin" />
                      Loading...
                    </>
                  ) : (
                    <>
                      <Users className="mr-2 h-4 w-4" />
                      Load More Venues
                    </>
                  )}

                </Button>

              </div>
            )}

        </div>
      </div>
    </div>
  );
}
