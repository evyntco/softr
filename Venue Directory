  iceMachineAvailable: "Ice Machine Available",
  waterAccess: "Water Access",

  minBartendersRequired: "Min Bartenders Required",
  serveTimeLimit: "Serve Time Limit (Hours)",

  stageAvailable: "Stage Available",

  trashResponsibility: "Trash Responsibility",
});

/* =========================================================
   VALUE HELPERS
========================================================= */

function valueToText(value) {
  if (value === null || value === undefined) return "";

  if (typeof value === "string") {
    return value;
  }

  if (typeof value === "number") {
    return String(value);
  }

  if (typeof value === "boolean") {
    return value ? "Yes" : "No";
  }

  if (Array.isArray(value)) {
    return value
      .map((item) => valueToText(item))
      .filter(Boolean)
      .join(", ");
  }

  if (typeof value === "object") {
    if (value.label) return valueToText(value.label);
    if (value.name) return valueToText(value.name);
    if (value.title) return valueToText(value.title);

    if (value.value !== undefined) {
      return valueToText(value.value);
    }

    if (value.url) {
      return valueToText(value.url);
    }

    return Object.values(value)
      .map((item) => valueToText(item))
      .filter(Boolean)
      .join(", ");
  }

  return "";
}

function valueIsYes(value) {
  if (value === true) return true;

  if (
    value === false ||
    value === null ||
    value === undefined
  ) {
    return false;
  }

  const text = valueToText(value)
    .trim()
    .toLowerCase();

  if (!text) return false;

  return ![
    "no",
    "false",
    "0",
    "none",
    "n/a",
    "not applicable",
    "not allowed",
  ].includes(text);
}

function cleanUrl(value) {
  const raw = valueToText(value).trim();

  if (!raw) return "";

  if (
    raw.startsWith("https://") ||
    raw.startsWith("http://")
  ) {
    return raw;
  }

  return `https://${raw}`;
}

/* =========================================================
   VENUE FEATURE BADGE
========================================================= */

function FeatureBadge({
  enabled,
  enabledText,
  disabledText,
  hideIfDisabled = false,
}) {
  if (!enabled && hideIfDisabled) {
    return null;
  }

  return (
    <Badge
      variant="outline"
      className={
        enabled
          ? "border-emerald-200 bg-emerald-50 text-emerald-800"
          : "border-[#ddd7ca] bg-[#f7f5ef] text-[#756c60]"
      }
    >
      {enabled ? enabledText : disabledText}
    </Badge>
  );
}

/* =========================================================
