          </div>

          {/* =================================================
              LOADING
          ================================================= */}

          {status === "pending" && (
            <div className="rounded-2xl border border-[#e4dfd3] bg-white p-12 text-center">

              <RefreshCw className="mx-auto mb-3 h-7 w-7 animate-spin text-[#b48a45]" />

              <p className="text-sm text-[#6d6253]">
                Loading venues...
              </p>

            </div>
          )}

          {/* =================================================
              ERROR
          ================================================= */}

          {status === "error" && (
            <div className="rounded-2xl border border-red-200 bg-red-50 p-8">

              <AlertCircle className="mb-3 h-7 w-7 text-red-700" />

              <h3 className="font-semibold text-red-900">
                Unable to load venues
              </h3>

              <p className="mt-2 text-sm text-red-700">
                {error?.message ||
                  "Check the datasource connection and field mappings."}
              </p>

            </div>
          )}

          {/* =================================================
              EMPTY
          ================================================= */}

          {status === "success" &&
            filteredRecords.length === 0 && (
              <div className="rounded-2xl border border-[#e4dfd3] bg-white p-12 text-center">

                <Search className="mx-auto mb-3 h-8 w-8 text-[#b48a45]" />

                <h3 className="font-semibold text-[#111]">
                  No venues found
                </h3>

                <p className="mt-1 text-sm text-[#6d6253]">
                  Try adjusting your search or
                  filters.
                </p>

                <Button
                  variant="outline"
                  className="mt-4 border-[#d8d1c2]"
                  onClick={clearFilters}
                >
                  Clear Search & Filters
