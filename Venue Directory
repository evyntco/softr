    data,
    status,
    error,
    fetchNextPage,
    hasNextPage,
    isFetching,
    isFetchingNextPage,
    refetch,
  } = useRecords({
    select: venueSelect,
    orderBy: q.asc("venueName"),
    count: 100,
  });

  const records =
    data?.pages?.flatMap(
      (page) => page.items || []
    ) || [];

  const totalResults =
    data?.pages?.[0]?.total ??
    records.length;

  /* =======================================================
     FILTER OPTIONS
  ======================================================= */

  const regions = useMemo(() => {
    const values = records
      .map((record) =>
        valueToText(
          record.fields?.region
        ).trim()
      )
      .filter(Boolean);

    return [...new Set(values)].sort(
      (a, b) => a.localeCompare(b)
    );
  }, [records]);

  const venueTypes = useMemo(() => {
    const values = records
      .map((record) =>
        valueToText(
          record.fields?.venueType
        ).trim()
      )
      .filter(Boolean);

    return [...new Set(values)].sort(
      (a, b) => a.localeCompare(b)
    );
  }, [records]);

  /* =======================================================
     SEARCH + FILTER
  ======================================================= */

  const filteredRecords = useMemo(() => {
    const search =
      debouncedSearch.toLowerCase();

    return records.filter((record) => {
      const fields =
        record.fields || {};

      /* -----------------------------------------------
         TEXT SEARCH
      ------------------------------------------------ */

      const searchableValues = [
        fields.venueName,
        fields.venueType,
        fields.region,
        fields.venueAddress,
        fields.website,

        fields.coordinatorName,
        fields.coordinatorEmail,
        fields.coordinatorPhone,

        fields.approvedCaterers,
        fields.alcoholTypesAllowed,
        fields.trashResponsibility,
      ]
        .map((value) =>
          valueToText(value)
        )
        .join(" ")
        .toLowerCase();

      if (
        search &&
        !searchableValues.includes(search)
      ) {
        return false;
      }

      /* -----------------------------------------------
         REGION
      ------------------------------------------------ */

      const region = valueToText(
        fields.region
      ).trim();

      if (
        regionFilter !== "all" &&
        region !== regionFilter
      ) {
        return false;
      }

      /* -----------------------------------------------
         VENUE TYPE
      ------------------------------------------------ */

      const venueType = valueToText(
        fields.venueType
      ).trim();

      if (
        venueTypeFilter !== "all" &&
        venueType !== venueTypeFilter
      ) {
        return false;
      }

      /* -----------------------------------------------
         CATERING
      ------------------------------------------------ */

      const outsideCatering =
        valueIsYes(
          fields.outsideCateringAllowed
        );

      if (
        cateringFilter ===
          "outside-allowed" &&
        !outsideCatering
      ) {
        return false;
      }

      if (
        cateringFilter ===
          "restricted" &&
        outsideCatering
      ) {
        return false;
      }

      /* -----------------------------------------------
         ALCOHOL
      ------------------------------------------------ */

      const alcoholAllowed =
        valueIsYes(
          fields.alcoholAllowed
        );

      if (
        alcoholFilter === "allowed" &&
        !alcoholAllowed
      ) {
        return false;
      }

      if (
        alcoholFilter ===
          "not-allowed" &&
        alcoholAllowed
      ) {
        return false;
      }

      return true;
    });
