                      className="min-h-[110px]"
                    />
                  </FormField>

                  <FormField label="Vendor Parking">
                    <Textarea
                      value={formData.vendorParkingNotes}
                      onChange={(event) =>
                        change("vendorParkingNotes", event.target.value)
                      }
                      className="min-h-[100px]"
                    />
                  </FormField>

                  <FormField label="Power Access">
                    <Textarea
                      value={formData.powerAccessNotes}
                      onChange={(event) =>
                        change("powerAccessNotes", event.target.value)
                      }
                      className="min-h-[100px]"
                    />
                  </FormField>

                  <FormField label="Onsite Staff Notes">
                    <Textarea
                      value={formData.onsiteStaffNotes}
                      onChange={(event) =>
                        change("onsiteStaffNotes", event.target.value)
                      }
                      className="min-h-[100px]"
                    />
                  </FormField>
                </div>
              </WorkspaceSection>
            )}

            {activeSection === "bar" && (
              <WorkspaceSection
                icon={Wine}
                eyebrow="Beverage Operations"
                title="Bar & beverage"
                description="The bar rules and onsite conditions that matter most before staffing or service begins."
              >
                <div className="grid gap-3 md:grid-cols-2">
                  <ToggleField
                    label="Alcohol Allowed"
                    description="Venue permits alcohol service onsite."
                    checked={formData.alcoholAllowed}
                    onCheckedChange={(value) =>
                      change("alcoholAllowed", value)
                    }
                  />

                  <ToggleField
                    label="Water Access"
                    description="Bar staff have reasonable access to potable water."
                    checked={formData.waterAccess}
                    onCheckedChange={(value) => change("waterAccess", value)}
                  />
                </div>

                <div className="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  <ReadOnlyField
                    label="Bar Setup Provided"
                    value={original.barSetupProvided}
                  />
                  <ReadOnlyField
                    label="Ice Machine"
                    value={original.iceMachine}
                  />
                  <ReadOnlyField
                    label="Shots Allowed"
                    value={original.shotsAllowed}
                  />
                  <ReadOnlyField
                    label="Alcohol Types Allowed"
                    value={original.alcoholTypesAllowed}
                  />
                  <ReadOnlyField
                    label="Min Bartenders"
                    value={original.minBartenders}
                  />
                  <ReadOnlyField
                    label="Outside Catering"
                    value={original.outsideCateringAllowed}
                  />
                </div>

                <div className="mt-6 grid gap-5 md:grid-cols-3">
                  <FormField label="Serve Time Limit (Hours)">
                    <Input
                      type="number"
                      min="0"
                      step="0.5"
                      value={formData.serveTimeAllowed}
                      onChange={(event) =>
                        change("serveTimeAllowed", event.target.value)
                      }
                    />
                  </FormField>

                  <FormField label="Signature Cocktail Limit">
                    <Input
                      value={formData.signatureCocktailLimit}
                      onChange={(event) =>
                        change("signatureCocktailLimit", event.target.value)
                      }
                    />
                  </FormField>

                  <FormField label="Trash Responsibility">
                    <Input
                      value={formData.trashResponsibility}
                      onChange={(event) =>
                        change("trashResponsibility", event.target.value)
                      }
                      placeholder="Venue, caterer, bar team..."
                    />
                  </FormField>
                </div>
              </WorkspaceSection>
            )}

            {activeSection === "policies" && (
              <WorkspaceSection
                icon={ShieldCheck}
                eyebrow="Venue Rules"
                title="Policies & compliance"
                description="Keep the rules vendors need to follow in one place."
              >
                <div className="grid gap-5 md:grid-cols-2">
                  <FormField label="Decor Rules">
                    <Textarea
                      value={formData.decorRules}
                      onChange={(event) =>
                        change("decorRules", event.target.value)
                      }
                      className="min-h-[100px]"
                    />
                  </FormField>

                  <FormField label="Candle / Open Flame Policy">
                    <Textarea
                      value={formData.candleOpenFlamePolicy}
                      onChange={(event) =>
                        change("candleOpenFlamePolicy", event.target.value)
                      }
                      className="min-h-[100px]"
                    />
                  </FormField>

                  <FormField label="Sound Restrictions">
                    <Textarea
                      value={formData.soundRestrictions}
                      onChange={(event) =>
                        change("soundRestrictions", event.target.value)
                      }
                      className="min-h-[100px]"
                    />
                  </FormField>

                  <FormField label="Approved Caterers">
                    <Textarea
                      value={formData.approvedCaterers}
                      onChange={(event) =>
                        change("approvedCaterers", event.target.value)
                      }
                      className="min-h-[100px]"
                    />
                  </FormField>

                  <FormField label="Insurance Requirements">
                    <Textarea
                      value={formData.insuranceRequirements}
                      onChange={(event) =>
                        change("insuranceRequirements", event.target.value)
                      }
                      className="min-h-[100px]"
                    />
                  </FormField>

                  <FormField label="Vendor Insurance Requirements">
                    <Textarea
                      value={formData.vendorInsuranceRequirements}
                      onChange={(event) =>
                        change("vendorInsuranceRequirements", event.target.value)
                      }
                      className="min-h-[100px]"
                    />
                  </FormField>

                  <FormField label="Security Required">
                    <Input
                      value={formData.securityRequired}
                      onChange={(event) =>
                        change("securityRequired", event.target.value)
                      }
                    />
                  </FormField>

                  <FormField label="Min Security Staff">
                    <Input
                      value={formData.minSecurityStaff}
                      onChange={(event) =>
                        change("minSecurityStaff", event.target.value)
                      }
                    />
                  </FormField>

                  <FormField label="Additional Insured Required">
                    <Input
                      value={formData.additionalInsuredRequired}
                      onChange={(event) =>
                        change("additionalInsuredRequired", event.target.value)
                      }
                    />
                  </FormField>
                </div>
              </WorkspaceSection>
            )}

            {activeSection === "notes" && (
              <div className="space-y-5">
                <WorkspaceSection
                  icon={FileText}
                  eyebrow="Venue Information"
                  title="Venue notes"
                  description="Keep general venue context, operating notes, and anything event teams should know."
                >
                  <FormField label="Notes">
                    <Textarea
                      value={formData.notes}
                      onChange={(event) => change("notes", event.target.value)}
                      placeholder="General venue notes..."
                      className="min-h-[220px]"
                    />
                  </FormField>
                </WorkspaceSection>

                {!isVenueStaff && (
                  <WorkspaceSection
                    icon={KeyRound}
                    eyebrow="Back Office"
                    title="System & source fields"
                    description="Operational database information kept out of the venue-facing view."
                  >
                    <div className="grid gap-3 md:grid-cols-2">
                      <ReadOnlyField
                        label="Files & Media"
                        value={original.filesMedia}
                      />
                      <ReadOnlyField
                        label="Page Content"
                        value={original.pageContent}
                      />
                      <ReadOnlyField
                        label="2025 Review Completed?"
                        value={original.review2025Completed}
                      />
                      <ReadOnlyField
                        label="QuickBooks Customer ID"
                        value={formData.quickbooksCustomerID}
                      />
                    </div>

                    <div className="mt-4 rounded-xl border border-[#E7E2D8] bg-[#F8F6F1] p-4">
                      <p className="text-[10px] font-bold uppercase tracking-[0.11em] text-[#8D8478]">
                        Venue Record ID
                      </p>
                      <p className="mt-1 break-all font-mono text-xs text-[#6E665C]">
                        {recordId}
                      </p>
                      <p className="mt-2 text-[11px] text-[#958B7E]">
                        Source: {urlRecordId ? "URL parameter" : "Softr current record context"}
                      </p>
                    </div>
                  </WorkspaceSection>
                )}
              </div>
            )}
          </div>

          <div className="sticky bottom-3 z-30 mt-6">
            <div className="flex flex-col gap-3 rounded-2xl border border-black/10 bg-[#171714] p-4 text-white shadow-2xl sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p className="text-sm font-semibold">
                  {dirty
                    ? "You have unsaved venue changes."
                    : "This venue is up to date."}
                </p>
                <p className="mt-1 text-xs text-white/50">
                  Save venue details here, then move into preferred vendors or venue events.
                </p>
              </div>

              <div className="flex w-full gap-2 sm:w-auto">
                <Button
                  type="button"
                  variant="outline"
                  onClick={openPreferredVendorLists}
                  className="flex-1 border-white/20 bg-transparent text-white hover:bg-white/10 hover:text-white sm:flex-none"
                >
                  <ListChecks className="mr-2 h-4 w-4" />
                  Preferred Vendors
                </Button>

                <Button
                  type="button"
                  variant="outline"
                  onClick={openVenueEvents}
                  className="flex-1 border-white/20 bg-transparent text-white hover:bg-white/10 hover:text-white sm:flex-none"
                >
                  <CalendarDays className="mr-2 h-4 w-4" />
                  Venue Events
                </Button>

                <Button
                  type="button"
                  onClick={handleSave}
                  disabled={saving || !dirty || !updateVenue.enabled}
                  className="flex-1 bg-[#D6B372] text-[#171714] hover:bg-[#E2C58F] sm:flex-none"
                >
                  {saving ? (
                    <>
                      <RefreshCw className="mr-2 h-4 w-4 animate-spin" />
                      Saving
                    </>
                  ) : (
                    <>
                      <Save className="mr-2 h-4 w-4" />
                      Save
                    </>
                  )}
                </Button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
