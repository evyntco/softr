/* =========================================================
   HELPERS
========================================================= */

function toText(value) {
  if (value === null || value === undefined) return "";
  if (typeof value === "string") return value;
  if (typeof value === "number") return String(value);
  if (typeof value === "boolean") return value ? "Yes" : "No";

  if (Array.isArray(value)) {
    return value.map((item) => toText(item)).filter(Boolean).join(", ");
  }

  if (typeof value === "object") {
    if (value.label) return String(value.label);
    if (value.name) return String(value.name);
    if (value.title) return String(value.title);
    if (value.value !== undefined) return toText(value.value);
    if (value.url) return String(value.url);
    if (value.filename) return String(value.filename);
  }

  return "";
}

function toBoolean(value) {
  if (value === true) return true;
  if (value === false) return false;

  const text = toText(value).trim().toLowerCase();
  if (!text) return false;

  return !["no", "false", "0", "none", "n/a", "not applicable"].includes(text);
}

function toNumberInput(value) {
  if (value === null || value === undefined || value === "") return "";
  if (typeof value === "number") return String(value);

  const parsed = Number(toText(value));
  return Number.isNaN(parsed) ? "" : String(parsed);
}

function numberOrNull(value) {
  if (value === "" || value === null || value === undefined) return null;
  const parsed = Number(value);
  return Number.isNaN(parsed) ? null : parsed;
}

function appendQuery(destination, params) {
  const separator = destination.includes("?") ? "&" : "?";
  return `${destination}${separator}${params.toString()}`;
}

function getRecordIdFromUrl() {
  if (typeof window === "undefined") return "";

  const params = new URLSearchParams(window.location.search);

  return String(
    params.get("recordId") ||
    params.get("venueRecordId") ||
    params.get("id") ||
    ""
  ).trim();
}

function normalizedEmail(value) {
  return String(value || "")
    .trim()
    .toLowerCase();
}

function navigateWithVenueContext(navigation, fallbackDestination, recordId, venueName) {
  if (!recordId) {
    toast.error("This venue does not have a record ID.");
    return;
  }

  const destination =
    navigation?.destination ||
    fallbackDestination;

  const params = new URLSearchParams();

  /*
   * Pass both names so downstream pages can use either convention.
   * recordId = general detail-page convention
   * venueRecordId = explicit venue foreign-key convention
   */
  params.set("recordId", String(recordId));
  params.set("venueRecordId", String(recordId));

  if (venueName) {
    params.set("venueName", venueName);
  }

  const nextUrl = appendQuery(destination, params);

  if (navigation?.openIn === "TAB") {
    window.open(nextUrl, "_blank");
  } else {
    window.location.assign(nextUrl);
  }
}

