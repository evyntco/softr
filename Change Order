/* =========================================================
   HELPERS
========================================================= */

function text(value) {
  if (value === null || value === undefined) return "";
  if (typeof value === "string" || typeof value === "number") return String(value);
  if (typeof value === "boolean") return value ? "Yes" : "No";

  if (Array.isArray(value)) {
    return value.map((item) => text(item)).filter(Boolean).join(", ");
  }

  if (typeof value === "object") {
    if (value.label) return text(value.label);
    if (value.name) return text(value.name);
    if (value.title) return text(value.title);
    if (value.value !== undefined) return text(value.value);
  }

  return "";
}

function readRecordIdFromUrl() {
  if (typeof window === "undefined") return "";

  const params = new URLSearchParams(window.location.search);

  return (
    params.get("recordId") ||
    params.get("beverageRecordId") ||
    ""
  ).trim();
}

function flattenPages(data) {
  return data?.pages?.flatMap((page) => page.items || []) || [];
}

function generateChangeOrderId() {
  const now = new Date();
  const stamp = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, "0"),
    String(now.getDate()).padStart(2, "0"),
  ].join("");

  const suffix = Math.random().toString(36).slice(2, 6).toUpperCase();
  return `CO-${stamp}-${suffix}`;
}

function dateText(value) {
  const raw = text(value).trim();
  if (!raw) return "";

  const match = raw.match(/^(\d{4})-(\d{2})-(\d{2})/);
  return match ? `${match[1]}-${match[2]}-${match[3]}` : raw;
}

function currentUserText(user) {
  return text(user?.name) || text(user?.fullName) || text(user?.email);
}

function normalized(value) {
  return text(value).trim().replace(/\s+/g, " ").toLowerCase();
}

