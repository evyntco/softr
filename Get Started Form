/* =========================================================
   PERSISTENT EVENT IDS

   These IDs are created BEFORE the database record exists.
   That means the form never has to depend on Softr returning
   its internal datasource record.id after creation.
========================================================= */

function generateWorkspaceToken() {
  if (
    typeof crypto !== "undefined" &&
    typeof crypto.randomUUID === "function"
  ) {
    return `workspace-${crypto.randomUUID()}`;
  }

  return `workspace-${Date.now()}-${Math.random()
    .toString(36)
    .slice(2, 12)}`;
}

function generateLeadRecordId() {
  if (
    typeof crypto !== "undefined" &&
    typeof crypto.randomUUID === "function"
  ) {
    return `lead-${crypto.randomUUID()}`;
  }

  return `lead-${Date.now()}-${Math.random()
    .toString(36)
    .slice(2, 12)}`;
}


