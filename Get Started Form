function safeValue(value, fallback = "") {
  if (value === null || value === undefined || value === "") {
    return fallback;
  }

  if (Array.isArray(value)) {
    return value
      .map((item) => {
        if (typeof item === "string" || typeof item === "number") {
          return String(item);
        }
        if (item?.name) return item.name;
        if (item?.title) return item.title;
        if (item?.label) return item.label;
        if (item?.value) return item.value;
        return "";
      })
      .filter(Boolean)
      .join(", ");
  }

  if (typeof value === "object") {
    const obj = value;
    if (obj?.name) return String(obj.name);
    if (obj?.title) return String(obj.title);
    if (obj?.label) return String(obj.label);
    if (obj?.value) return String(obj.value);
  }

  return String(value);
}

function normalizeUSPhone(raw) {
  if (!raw) return "";
  const trimmed = String(raw).trim();

  if (trimmed.startsWith("+")) {
    return trimmed.replace(/[^\d+]/g, "").replace(/(?!^)\+/g, "");
  }

  const digits = trimmed.replace(/\D/g, "");

  if (digits.length === 10) {
    return `+1${digits}`;
  }

  if (digits.length === 11 && digits.startsWith("1")) {
    return `+${digits}`;
  }

  return digits ? `+${digits}` : "";
}

function isValidEmail(value) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(value || "").trim());
}

function timeToDisplay(value) {
  if (!value) return "";
  const parts = value.split(":");
  if (parts.length !== 2) return value;

  let hours = Number(parts[0]);
  const minutes = parts[1];
  const period = hours >= 12 ? "PM" : "AM";
  hours = hours % 12 || 12;

  return `${hours}:${minutes} ${period}`;
}

function timeToMinutes(value) {
  if (!value) return null;
  const parts = String(value).split(":");
  if (parts.length !== 2) return null;

  const hours = Number(parts[0]);
  const minutes = Number(parts[1]);

  if (Number.isNaN(hours) || Number.isNaN(minutes)) return null;
  return hours * 60 + minutes;
}

function minutesToTime(totalMinutes) {
  const normalized = ((Number(totalMinutes) % 1440) + 1440) % 1440;
  const hours = Math.floor(normalized / 60);
  const minutes = normalized % 60;

  return `${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}`;
}

function buildTimeOptions(startMinutes, endMinutes) {
  const options = [];

  for (let total = startMinutes; total <= endMinutes; total += 15) {
    const value = minutesToTime(total);
    const nextDay = total >= 1440;

    options.push({
      key: `${total}`,
      value,
      label: `${timeToDisplay(value)}${nextDay ? " (next day)" : ""}`,
      nextDay,
    });
  }

  return options;
}

