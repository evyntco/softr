                  <div className="mb-8">
                    <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#9e5a3c]">
                      Step 1 of 3
                    </p>
                    <h2 className="mt-2 text-3xl font-medium tracking-[-0.03em] text-[#111111]">
                      Get Started
                    </h2>
                    <p className="mt-2 text-sm leading-6 text-[#777773]">
                      Tell us when, where and what kind of service you're looking for.
                    </p>
                  </div>

                  <div className="space-y-7">
                    {/* EVENT DATE */}
                    <div>
                      <FieldLabel required>Event Date</FieldLabel>
                      <div className="relative">
                        <CalendarDays className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                        <Input
                          type="date"
                          value={eventDate}
                          onChange={(event) => setEventDate(event.target.value)}
                          className="h-12 pl-11"
                        />
                      </div>
                    </div>

                    {/* VENUE */}
                    <div>
                      <FieldLabel
                        required
                        helper="Search our venue list by venue name or address. If it isn't listed, you can enter the location manually."
                      >
                        Venue Name / Event Location
                      </FieldLabel>

                      {!manualVenueMode ? (
                        <div>
                          <div className="relative">
                            <Search className="absolute left-4 top-1/2 z-10 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                            <Input
                              value={venueSearch}
                              onChange={(event) => {
                                setVenueSearch(event.target.value);
                                setSelectedVenue(null);
                                setShowVenueResults(true);
                              }}
                              onFocus={() => setShowVenueResults(true)}
                              placeholder="Search venue name or address..."
                              className="h-12 pl-11"
                            />

                            {showVenueResults && searchTerm.length >= 2 && !selectedVenue && (
                              <div className="absolute z-40 mt-2 max-h-80 w-full overflow-auto rounded-xl border border-[#DADAD6] bg-white p-2 shadow-xl">
                                {venueFetching && (
                                  <div className="flex items-center justify-center gap-2 px-4 py-6 text-sm text-[#777773]">
                                    <Loader2 className="h-4 w-4 animate-spin" />
                                    Searching venues...
                                  </div>
                                )}

                                {!venueFetching &&
                                  venueResults.map((venue) => {
                                    const name = safeValue(venue.fields?.name);
                                    const address = safeValue(venue.fields?.address);
                                    return (
                                      <button
                                        key={venue.id}
                                        type="button"
                                        onClick={() => chooseVenue(venue)}
                                        className="flex w-full items-start gap-3 rounded-lg p-3 text-left transition hover:bg-[#F7F7F5]"
                                      >
                                        <Building2 className="mt-0.5 h-5 w-5 shrink-0 text-[#8A8A86]" />
                                        <div className="min-w-0">
                                          <p className="font-semibold text-[#171717]">{name}</p>
                                          {address && (
                                            <p className="mt-1 text-xs leading-5 text-[#777773]">
                                              {address}
                                            </p>
                                          )}
                                        </div>
                                      </button>
                                    );
                                  })}

                                {!venueFetching &&
                                  venueStatus === "success" &&
                                  venueResults.length === 0 && (
                                    <div className="px-4 py-4">
                                      <p className="text-sm font-semibold text-[#171717]">
                                        We couldn't find that venue.
                                      </p>
                                      <p className="mt-1 text-xs leading-5 text-[#777773]">
                                        That's okay. You can enter the venue name or address manually.
                                      </p>
                                    </div>
                                  )}

                                <div className="border-t border-[#EEEEEB] p-2">
                                  <button
                                    type="button"
                                    onClick={useManualVenue}
                                    className="flex w-full items-center gap-3 rounded-lg p-3 text-left text-sm font-semibold text-[#9e5a3c] transition hover:bg-[#F7F7F5]"
                                  >
                                    <MapPin className="h-4 w-4" />
                                    Use "{venueSearch || "another location"}" manually
                                  </button>
                                </div>
                              </div>
                            )}
                          </div>

                          {selectedVenue && (
                            <div className="mt-3 rounded-xl border border-[#DADAD6] bg-[#F7F7F5] p-4">
                              <div className="flex items-start gap-3">
                                <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-[#171717]" />
                                <div className="flex-1">
                                  <p className="font-semibold text-[#171717]">
                                    {selectedVenue.name}
                                  </p>
                                  {selectedVenue.address && (
                                    <p className="mt-1 text-xs text-[#777773]">
                                      {selectedVenue.address}
                                    </p>
                                  )}
                                </div>
                                <button
                                  type="button"
                                  onClick={() => {
                                    setSelectedVenue(null);
                                    setVenueSearch("");
                                    setShowVenueResults(true);
                                  }}
                                  className="text-xs font-semibold text-[#777773] underline"
                                >
                                  Change
                                </button>
                              </div>
                            </div>
                          )}

                          <button
                            type="button"
                            onClick={() => {
                              setManualVenueMode(true);
                              setSelectedVenue(null);
                              setManualVenue(venueSearch);
                            }}
                            className="mt-3 text-xs font-semibold text-[#777773] underline underline-offset-4"
                          >
                            Venue not listed? Enter event address.
                          </button>
                        </div>
                      ) : (
                        <div>
                          <div className="relative">
                            <MapPin className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                            <Input
                              value={manualVenue}
                              onChange={(event) => setManualVenue(event.target.value)}
                              placeholder="Venue name, street address, city or event location"
                              className="h-12 pl-11"
                              autoFocus
                            />
                          </div>
                          <p className="mt-2 text-xs leading-5 text-[#8A8A86]">
                            Enter enough information for our team to identify the event location.
                          </p>
                          <button
                            type="button"
                            onClick={() => {
                              setManualVenueMode(false);
                              setManualVenue("");
                              setVenueSearch("");
                            }}
                            className="mt-3 text-xs font-semibold text-[#777773] underline underline-offset-4"
                          >
                            Search the venue list instead
                          </button>
                        </div>
                      )}
                    </div>

                    {/* EVENT TYPE */}
                    <div>
                      <FieldLabel required>Event Type</FieldLabel>
                      <Select value={eventType} onValueChange={setEventType}>
                        <SelectTrigger className="h-12">
                          <SelectValue placeholder="Select event type" />
                        </SelectTrigger>
                        <SelectContent>
                          {eventTypeChoices.map((option) => (
                            <SelectItem key={option} value={option}>
                              {option}
                            </SelectItem>
                          ))}
                        </SelectContent>
                      </Select>
                    </div>

                    {/* SERVICES */}
                    <div>
                      <FieldLabel
                        required
                        helper="Choose everything you're currently considering. You can refine the service later."
                      >
                        Services you're needing
                      </FieldLabel>
                      <div className="grid gap-3 md:grid-cols-2">
                        {serviceChoices.map((service) => (
                          <ServiceChoice
                            key={service.id}
                            label={service.label}
                            checked={services.includes(service.id)}
                            onChange={(checked) => toggleService(service.id, checked)}
                          />
                        ))}
                      </div>
                    </div>

                    {/* TIMES */}
                    <div className="grid gap-5 sm:grid-cols-2">
                      <div>
                        <FieldLabel helper="15-minute increments from 10:30 AM through 9:00 PM.">
                          Bar Service Start Time
                        </FieldLabel>
                        <div className="relative">
                          <Clock3 className="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                          <select
                            value={barStartTime}
                            onChange={(event) => handleBarStartTimeChange(event.target.value)}
                            className="h-12 w-full appearance-none rounded-md border border-input bg-background pl-11 pr-4 text-sm"
                          >
                            <option value="">Select start time</option>
                            {BAR_START_OPTIONS.map((option) => (
                              <option key={option.key} value={option.value}>
                                {option.label}
                              </option>
                            ))}
                          </select>
                        </div>
                      </div>

                      <div>
                        <FieldLabel helper="Defaults to 4 hours after the selected start time. Close times run from 12:00 PM through 2:00 AM.">
                          Bar Service Close Time
                        </FieldLabel>
                        <div className="relative">
                          <Clock3 className="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                          <select
                            value={barCloseTime}
                            onChange={(event) => setBarCloseTime(event.target.value)}
                            className="h-12 w-full appearance-none rounded-md border border-input bg-background pl-11 pr-4 text-sm"
                          >
                            <option value="">Select close time</option>
                            {BAR_CLOSE_OPTIONS.map((option) => (
                              <option key={option.key} value={option.value}>
                                {option.label}
                              </option>
                            ))}
                          </select>
                        </div>

                        {barCloseIsNextDay && (
                          <div className="mt-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700">
                            NEXT DAY — this close time is after midnight and falls on the calendar day after the event start time.
                          </div>
                        )}
                      </div>
                    </div>

                    {/* DETAILS */}
                    <div>
                      <FieldLabel helper="Anything else we should know about the bar, beverages or service you're considering?">
                        Additional Service Details
                      </FieldLabel>
                      <Textarea
                        value={additionalDetails}
                        onChange={(event) => setAdditionalDetails(event.target.value)}
                        placeholder="Example: We're looking for a non-alcoholic bar, signature drinks, special setup requirements, etc."
                        className="min-h-[120px]"
                      />
                    </div>
                  </div>
                </div>
              )}

              {/* STEP 2 */}
              {step === 2 && (
                <div>
                  <div className="mb-8">
                    <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#9e5a3c]">
                      Step 2 of 3
                    </p>
                    <h2 className="mt-2 text-3xl font-medium tracking-[-0.03em] text-[#111111]">
                      Tell us about your guests
                    </h2>
                    <p className="mt-2 text-sm leading-6 text-[#777773]">
                      Estimates are completely fine. This just helps us understand the size and type of service you may need.
                    </p>
                  </div>

                  <div className="space-y-7">
                    <div className="grid gap-5 sm:grid-cols-2">
                      <div>
                        <FieldLabel required>Estimated Total Guest Count</FieldLabel>
                        <div className="relative">
                          <Users className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                          <Input
                            value={totalGuests}
                            onChange={(event) => setTotalGuests(event.target.value)}
                            inputMode="numeric"
                            placeholder="Example: 200"
                            className="h-12 pl-11"
                          />
                        </div>
                      </div>
                      <div>
                        <FieldLabel required helper="Enter 0 if this is a completely non-alcoholic event.">
                          Estimated Total Alcohol Drinking Guests (21+)
                        </FieldLabel>
                        <div className="relative">
                          <Martini className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                          <Input
                            value={alcoholGuests}
                            onChange={(event) => setAlcoholGuests(event.target.value)}
                            inputMode="numeric"
                            placeholder="Example: 150"
                            className="h-12 pl-11"
                          />
                        </div>
                      </div>
                    </div>

                    <div className="rounded-xl border border-[#E1E1DD] bg-[#F7F7F5] p-5">
                      <div className="flex items-start gap-3">
                        <Sparkles className="mt-0.5 h-4 w-4 shrink-0 text-[#9e5a3c]" />
                        <div>
                          <p className="text-sm font-semibold text-[#171717]">
                            The next few questions are optional.
                          </p>
                          <p className="mt-1 text-xs leading-5 text-[#777773]">
                            Telling us more specifically who you expect us to serve helps our team better prepare staffing, quantities and service.
                          </p>
                        </div>
                      </div>
                    </div>

                    <div className="grid gap-5 sm:grid-cols-2">
                      <div>
                        <FieldLabel>Estimated Non Alcoholic Drinkers we are serving</FieldLabel>
                        <div className="relative">
                          <GlassWater className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                          <Input
                            value={nonAlcoholic}
                            onChange={(event) => setNonAlcoholic(event.target.value)}
                            placeholder="Optional"
                            className="h-12 pl-11"
                          />
                        </div>
                      </div>
                      <div>
                        <FieldLabel>Estimated Cocktail Drinkers we are serving</FieldLabel>
                        <div className="relative">
                          <Martini className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                          <Input
                            value={cocktails}
                            onChange={(event) => setCocktails(event.target.value)}
                            placeholder="Optional"
                            className="h-12 pl-11"
                          />
                        </div>
                      </div>
                      <div>
                        <FieldLabel>Estimated Beer Drinkers we are serving</FieldLabel>
                        <div className="relative">
                          <GlassWater className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                          <Input
                            value={beer}
                            onChange={(event) => setBeer(event.target.value)}
                            placeholder="Optional"
                            className="h-12 pl-11"
                          />
                        </div>
                      </div>
                      <div>
                        <FieldLabel>Estimated Wine Drinkers we are serving</FieldLabel>
                        <div className="relative">
                          <Wine className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                          <Input
                            value={wine}
                            onChange={(event) => setWine(event.target.value)}
                            placeholder="Optional"
                            className="h-12 pl-11"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {/* STEP 3 */}
              {step === 3 && (
                <div>
                  <div className="mb-8">
                    <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#9e5a3c]">
                      Step 3 of 3
                    </p>
                    <h2 className="mt-2 text-3xl font-medium tracking-[-0.03em] text-[#111111]">
                      Where should we send your estimate?
                    </h2>
                    <p className="mt-2 text-sm leading-6 text-[#777773]">
                      Give us the best contact information for this event and we'll take it from here.
                    </p>
                  </div>

                  <div className="space-y-7">
                    {/* NAME */}
                    <div>
                      <FieldLabel required>Your Name</FieldLabel>
                      <Input
                        value={hostName}
                        onChange={(event) => setHostName(event.target.value)}
                        placeholder="First and last name"
                        className="h-12"
                      />
                    </div>

                    {/* PHONE */}
                    <div>
                      <FieldLabel required>Best Phone</FieldLabel>
                      <div className="relative">
                        <div className="absolute left-4 top-1/2 flex -translate-y-1/2 items-center gap-2 border-r border-[#E1E1DD] pr-3">
                          <span className="text-base">🇺🇸</span>
                          <span className="text-xs font-semibold text-[#777773]">+1</span>
                        </div>
                        <Input
                          value={phone}
                          onChange={(event) => setPhone(event.target.value)}
                          type="tel"
                          placeholder="801 555 1234"
                          className="h-12 pl-[88px]"
                        />
                      </div>
                    </div>

                    {/* EMAIL */}
                    <div>
                      <FieldLabel required>Best email to reach you</FieldLabel>
                      <div className="relative">
                        <Mail className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />
                        <Input
                          type="email"
                          value={email}
                          onChange={(event) => setEmail(event.target.value)}
                          placeholder="you@example.com"
                          className="h-12 pl-11"
                        />
                      </div>
                    </div>

                    {/* BEST WAY */}
                    <div>
                      <FieldLabel required>Best Way to reach you</FieldLabel>
                      <div className="grid gap-3 sm:grid-cols-3">
                        {contactChoices.map((method) => {
                          const active = bestWayToReach === method.id;
                          return (
                            <button
                              key={method.id}
                              type="button"
                              onClick={() => setBestWayToReach(method.id)}
                              className={`rounded-xl border p-4 text-left transition ${active
                                  ? "border-[#9e5a3c] bg-[#9e5a3c]/5"
                                  : "border-[#E1E1DD] hover:border-[#BEBEB8]"
                                }`}
                            >
                              <div className="flex items-center justify-between gap-3">
                                <div className="flex items-center gap-2">
                                  {method.label.toLowerCase().includes("email") ? (
                                    <Mail className="h-4 w-4 text-[#777773]" />
                                  ) : method.label.toLowerCase().includes("text") ? (
                                    <MessageSquareText className="h-4 w-4 text-[#777773]" />
                                  ) : (
                                    <Phone className="h-4 w-4 text-[#777773]" />
                                  )}
                                  <span className="text-sm font-semibold text-[#171717]">
                                    {method.label}
                                  </span>
                                </div>
                                {active && <CheckCircle2 className="h-4 w-4 text-[#9e5a3c]" />}
                              </div>
                            </button>
                          );
                        })}
                      </div>
                    </div>

                    {/* REVIEW */}
                    <div className="rounded-xl border border-[#E1E1DD] bg-[#F7F7F5] p-5">
                      <p className="text-[10px] font-semibold uppercase tracking-[0.16em] text-[#8A8A86]">
                        Event Request
                      </p>
                      <div className="mt-4 grid gap-4 sm:grid-cols-2">
                        <div>
                          <p className="text-xs text-[#8A8A86]">Event</p>
                          <p className="mt-1 text-sm font-semibold text-[#171717]">{eventType}</p>
                        </div>
                        <div>
                          <p className="text-xs text-[#8A8A86]">Event Date</p>
                          <p className="mt-1 text-sm font-semibold text-[#171717]">{eventDate}</p>
                        </div>
                        <div>
                          <p className="text-xs text-[#8A8A86]">Location</p>
                          <p className="mt-1 text-sm font-semibold text-[#171717]">{eventLocation}</p>
                        </div>
                        <div>
                          <p className="text-xs text-[#8A8A86]">Estimated Guests</p>
                          <p className="mt-1 text-sm font-semibold text-[#171717]">{totalGuests}</p>
                        </div>
                      </div>
                      <div className="mt-4 border-t border-[#DFDFDB] pt-4">
                        <p className="text-xs text-[#8A8A86]">Services</p>
                        <p className="mt-1 text-sm font-semibold leading-6 text-[#171717]">
                          {services
                            .map((id) => {
                              const found = serviceChoices.find((s) => s.id === id);
                              return found ? found.label : id;
                            })
                            .join(", ")}
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {/* ERROR */}
              {error && (
                <div className="mt-7 rounded-xl border border-red-200 bg-red-50 p-4">
                  <p className="text-sm font-medium text-red-700">{error}</p>
                </div>
              )}

              {/* SUBMISSION PROGRESS */}
              {isSubmitting && (
                <div className="mt-7 rounded-xl border border-[#DADAD6] bg-[#F7F7F5] p-5">
                  <div className="flex items-center gap-3">
                    <Loader2 className="h-5 w-5 animate-spin text-[#9e5a3c]" />
                    <div>
                      <p className="text-sm font-semibold text-[#171717]">
                        {submissionStep === "creating-lead" && "Creating your request..."}
                      </p>
                      <p className="mt-1 text-xs leading-5 text-[#777773]">
                        Please don't close this page.
                      </p>
                    </div>
                  </div>
                </div>
              )}

              {/* NAVIGATION */}
              <div className="mt-9 flex flex-col-reverse gap-3 border-t border-[#E7E7E3] pt-6 sm:flex-row sm:items-center sm:justify-between">
                {step > 1 ? (
                  <Button
                    type="button"
                    variant="ghost"
                    onClick={previousStep}
                    disabled={isSubmitting}
                    className="h-12"
                  >
                    <ArrowLeft className="mr-2 h-4 w-4" />
                    Back
                  </Button>
                ) : (
                  <div />
                )}

                {step < 3 ? (
                  <Button
                    type="button"
                    onClick={nextStep}
                    className="h-12 bg-[#111111] px-7 font-semibold text-white hover:bg-[#303030]"
                  >
                    Continue
                    <ArrowRight className="ml-2 h-4 w-4" />
                  </Button>
                ) : (
                  <Button
                    type="button"
                    onClick={handleSubmit}
                    disabled={isSubmitting}
                    className="h-12 bg-[#9e5a3c] px-8 font-semibold text-white hover:bg-[#8a4e33]"
                  >
                    {isSubmitting ? (
                      <>
                        <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                        {submissionStep === "creating-lead" && "Creating Request..."}
                      </>
                    ) : (
                      <>
                        Submit My Request
                        <ArrowRight className="ml-2 h-4 w-4" />
                      </>
                    )}
                  </Button>
                )}
              </div>
            </div>
          </section>

          {/* FOOTER */}
          <div className="px-4 py-6 text-center">
            <p className="text-xs leading-5 text-[#8A8A86]">
              No payment is required to request an estimate.
              We'll review your event details and follow up with next steps.
            </p>
            <p className="mt-2 text-[10px] uppercase tracking-[0.14em] text-[#AAAAA6]">
              Cheers & Swizzles · Utah Event Beverage Service
            </p>
          </div>
        </div>
      </div>
    </div>
  );
}
