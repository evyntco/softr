function StepIndicator({ step }) {
  const steps = [
    { number: 1, label: "Event" },
    { number: 2, label: "Guests" },
    { number: 3, label: "Contact" },
  ];

  return (
    <div className="border-b border-[#E7E7E3] px-6 py-5 sm:px-8">
      <div className="mx-auto flex max-w-2xl items-center">
        {steps.map((item, index) => {
          const completed = step > item.number;
          const active = step === item.number;

          return (
            <React.Fragment key={item.number}>
              <div className="flex min-w-0 items-center gap-2">
                <div
                  className={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold ${completed
                      ? "bg-[#111111] text-white"
                      : active
                        ? "bg-[#9e5a3c] text-white"
                        : "bg-[#EFEFEC] text-[#8A8A86]"
                    }`}
                >
                  {completed ? <Check className="h-4 w-4" /> : item.number}
                </div>
                <span
                  className={`hidden text-xs font-semibold sm:block ${active ? "text-[#171717]" : "text-[#8A8A86]"
                    }`}
                >
                  {item.label}
                </span>
              </div>
              {index < steps.length - 1 && (
                <div className="mx-3 h-px flex-1 bg-[#DADAD6] sm:mx-5" />
              )}
            </React.Fragment>
          );
        })}
      </div>
    </div>
  );
}

