function toneForLeadStatus(status) {
  const s = (status || "").toLowerCase();
  if (s.includes("new")) return "new";
  if (s.includes("booked")) return "good";
  if (s.includes("estimate") || s.includes("progress")) return "warn";
  if (s.includes("lost")) return "danger";
  return "default";
}

/* =========================================================
   OPEN LEAD BUTTON

   Uses NavigationAction (same mechanism the estimator's CTA
   button uses) instead of raw window.location — that's the
   actual bridge that makes useNavigationSetting-driven links
   work inside Softr's block embed. Building the destination
   here, per-row, since each lead needs its own leadRecordId
   appended to whatever page the setting points at.

   NavigationAction owns the click/navigation behavior and
   applies it to the real DOM element passed as its child —
   it isn't Slot-compatible, so it must be the outer wrapper
   with a plain <button> inside, not nested inside
   `Button asChild` (that inversion silently drops both the
   styling and the click handler).
========================================================= */

function OpenLeadButton({ leadRecordId, navigationSetting, size = "default" }) {
  if (!leadRecordId) {
    return <span className="text-xs text-[#8A8A86]">No ID</span>;
  }

  const action = navigationSetting?.action === "OPEN_URL" ? "OPEN_URL" : "OPEN_PAGE";
  const baseDestination = navigationSetting?.destination || "/lead-record";
  const separator = baseDestination.includes("?") ? "&" : "?";
  const destination = `${baseDestination}${separator}leadRecordId=${encodeURIComponent(leadRecordId)}`;
  const openIn = navigationSetting?.openIn || "SELF";

  const sizeClasses = size === "sm" ? "h-7 px-2.5 text-[11px]" : "h-8 px-3 text-xs";

  return (
    <NavigationAction navigation={{ action, destination, openIn }}>
      <button
        type="button"
        className={`inline-flex items-center justify-center rounded-md font-semibold text-white bg-[#9e5a3c] hover:bg-[#8a4e33] ${sizeClasses}`}
      >
        Open
        <ArrowUpRight className="ml-1 h-3 w-3" />
      </button>
    </NavigationAction>
  );
}

function safeArray(value) {
  return [value];
}

function labelOf(value) {
  return typeof value === "object" && value ? value.label ?? "" : value ?? "";
}

/* =========================================================
   DATE HELPERS
========================================================= */

function startOfDay(d) {
  const x = new Date(d);
  x.setHours(0, 0, 0, 0);
  return x;
}
function endOfDay(d) {
  const x = new Date(d);
  x.setHours(23, 59, 59, 999);
  return x;
}

function getPresetRange(preset) {
  const now = new Date();

  if (preset === "this_week") {
    const day = now.getDay();
    const diffToMonday = (day === 0 ? -6 : 1) - day;
    const start = startOfDay(new Date(now));
    start.setDate(now.getDate() + diffToMonday);
    const end = endOfDay(new Date(start));
    end.setDate(start.getDate() + 6);
    return [start, end];
  }

  if (preset === "this_month") {
    const start = startOfDay(new Date(now.getFullYear(), now.getMonth(), 1));
    const end = endOfDay(new Date(now.getFullYear(), now.getMonth() + 1, 0));
    return [start, end];
  }

  if (preset === "next_month") {
    const start = startOfDay(new Date(now.getFullYear(), now.getMonth() + 1, 1));
    const end = endOfDay(new Date(now.getFullYear(), now.getMonth() + 2, 0));
    return [start, end];
  }

  return null;
}

function parseLeadDate(str) {
  if (!str) return null;
  const d = new Date(str);
  return Number.isNaN(d.getTime()) ? null : d;
}

