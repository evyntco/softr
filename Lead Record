                              </td>
                            </tr>
                          );
                        })}
                      </React.Fragment>
                    );
                  })}

                  {filteredGroups.length === 0 && (
                    <tr>
                      <td colSpan={7} className="px-3 py-10 text-center text-[#8A8A86]">
                        No leads match this filter.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </section>
        </div>
