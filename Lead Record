function PromoteCard({
  lead,
  updateStatus,
  updateError,
  onPromote,
}) {
  const [promoteState, setPromoteState] = useState("idle");
  const [promoteError, setPromoteError] = useState("");

  const currentStatus = getValue(
    lead && lead.fields ? lead.fields.leadStatus : ""
  ).toLowerCase();

  const alreadyBooked = currentStatus === "booked";

  async function handlePromote() {
    try {
      setPromoteState("working");
      setPromoteError("");

      await onPromote(lead.id);

      setPromoteState("done");
    } catch (err) {
      console.error(
        "[Lead Record] Status update failed:",
        err
      );

      setPromoteState("error");

      setPromoteError(
        (err && err.message) ||
          'Couldn\'t set Lead Status to "Booked." Confirm that "Booked" exists as an option on the Lead Status field.'
      );
    }
  }

  const isWorking =
    promoteState === "working" ||
    updateStatus === "pending";

  return (
    <section className="overflow-hidden rounded-2xl border border-[#E1E1DD] bg-white p-6">
      <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#9e5a3c]">
        Promote
      </p>

      <h3 className="mt-1 text-lg font-medium text-[#171717]">
        Mark as Booked
      </h3>

      <p className="mt-1 text-sm leading-6 text-[#777773]">
        Sets Lead Status to "Booked" on this record. Your
        Notion automation can then create the Master Event
        and Beverage Configuration records.
      </p>

      <div className="mt-4">
        <Button
          onClick={handlePromote}
          disabled={isWorking || alreadyBooked}
          className="h-11 w-full bg-[#9e5a3c] font-semibold text-white hover:bg-[#8a4e33]"
        >
          {isWorking && (
            <>
              <Loader2 className="mr-2 h-4 w-4 animate-spin" />
              Updating status...
            </>
          )}

          {!isWorking &&
            (alreadyBooked
              ? "Already Booked"
              : "Mark as Booked")}
        </Button>

        {promoteState === "error" && promoteError && (
          <p className="mt-2 text-xs text-red-600">
            {promoteError}
          </p>
        )}

        {updateError && (
          <p className="mt-2 text-xs text-red-600">
            {updateError}
          </p>
        )}

        {promoteState === "done" && (
          <p className="mt-2 flex items-center gap-1.5 text-xs text-green-700">
            <CheckCircle2 className="h-3.5 w-3.5" />
            Lead Status set to "Booked."
          </p>
        )}
      </div>
    </section>
  );
}

/* =========================================================
   EMAIL THREAD
========================================================= */

function EmailThread({ leadEmail, hostName }) {
  const proxyFetch = useProxyFetch(ds.gmail);

  const [replySubject, setReplySubject] =
    useState("");

  const [replyBody, setReplyBody] =
    useState("");

  const [sendState, setSendState] =
    useState("idle");

  const [sendError, setSendError] =
    useState("");

  const gmailQuery = leadEmail
    ? "(from:" +
      leadEmail +
      " OR to:" +
      leadEmail +
      ")"
    : null;

  const {
    data: searchData,
    status: searchStatus,
    isFetching,
    refetch,
  } = useQuery({
    queryKey: [
      "gmail-thread-search",
      leadEmail,
    ],

    queryFn: async function () {
      const res = await proxyFetch(
        "https://gmail.googleapis.com/gmail/v1/users/me/messages?q=" +
          encodeURIComponent(gmailQuery) +
          "&maxResults=50"
      );

      if (!res.ok) {
        throw new Error("Failed to search Gmail");
      }

      return res.json();
    },

    enabled: Boolean(leadEmail),
  });

  const messageIds =
    searchData && searchData.messages
      ? searchData.messages
      : [];

  const {
    data: messageDetails,
    status: detailStatus,
  } = useQuery({
    queryKey: [
      "gmail-thread-details",
      messageIds
        .map(function (message) {
          return message.id;
        })
        .join(","),
    ],

    queryFn: async function () {
      const details = await Promise.all(
        messageIds.map(async function (message) {
          const res = await proxyFetch(
            "https://gmail.googleapis.com/gmail/v1/users/me/messages/" +
              message.id +
              "?format=full"
          );

          if (!res.ok) return null;

          return res.json();
        })
      );

      return details.filter(function (item) {
        return Boolean(item);
      });
    },

    enabled: messageIds.length > 0,
  });

  const messages = useMemo(
    function () {
      const list = messageDetails || [];

      return [...list].sort(function (a, b) {
        return (
          Number(a.internalDate) -
          Number(b.internalDate)
        );
      });
    },
    [messageDetails]
  );

  const latestMessage =
    messages[messages.length - 1];

  async function handleSend() {
    if (!leadEmail || !replyBody.trim()) {
      return;
    }

    try {
      setSendState("sending");
      setSendError("");

      const subject =
        replySubject.trim() ||
        "Re: your event with Cheers & Swizzles";

      const headers = [
        "From: Cheers & Swizzles <" +
          HELLO_EMAIL +
          ">",
        "To: " + leadEmail,
        "Subject: " + subject,
      ];

      if (latestMessage) {
        const messageIdHeader = getHeader(
          latestMessage.payload
            ? latestMessage.payload.headers
            : null,
          "Message-ID"
        );

        if (messageIdHeader) {
          headers.push(
            "In-Reply-To: " + messageIdHeader
          );

          headers.push(
            "References: " + messageIdHeader
          );
        }
      }

      headers.push(
        'Content-Type: text/plain; charset="UTF-8"'
      );

      const mime = [
        ...headers,
        "",
        replyBody,
      ].join("\r\n");

      const raw = encodeBase64Url(mime);

      const payload = {
        raw: raw,
      };

      if (
        latestMessage &&
        latestMessage.threadId
      ) {
        payload.threadId =
          latestMessage.threadId;
      }

      const res = await proxyFetch(
        "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        }
      );

      if (!res.ok) {
        const errBody = await res.text();

        throw new Error(
          errBody || "Gmail send failed"
        );
      }

      setSendState("sent");
      setReplyBody("");
      setReplySubject("");

      await refetch();
    } catch (err) {
      console.error(
        "[Lead Record] Email send failed:",
        err
      );

      setSendState("error");

      setSendError(
        (err && err.message) ||
          "Something went wrong sending this email."
      );
    }
  }

  if (!leadEmail) {
    return (
      <div className="flex items-start gap-2 rounded-xl border border-[#E1E1DD] bg-[#F7F7F5] p-4 text-sm text-[#777773]">
        <Info className="mt-0.5 h-4 w-4 shrink-0" />
        No email on file for this lead.
      </div>
    );
  }

  const loading =
    searchStatus === "pending" ||
    (messageIds.length > 0 &&
      detailStatus === "pending");

  return (
    <div>
      <p className="mb-3 text-xs text-[#8A8A86]">
        Showing messages between{" "}
        <span className="font-medium text-[#555552]">
          {HELLO_EMAIL}
        </span>{" "}
        and{" "}
        <span className="font-medium text-[#555552]">
          {leadEmail}
        </span>
        .
        {isFetching && " · refreshing..."}
      </p>

      {loading && (
        <div className="flex items-center justify-center gap-2 py-10 text-[#777773]">
          <Loader2 className="h-4 w-4 animate-spin" />
          Loading conversation...
        </div>
      )}

      {!loading && messages.length === 0 && (
        <div className="rounded-xl border border-[#E1E1DD] bg-[#F7F7F5] p-4 text-sm text-[#777773]">
          No emails found yet between{" "}
          {HELLO_EMAIL} and{" "}
          {hostName || leadEmail}.
        </div>
      )}

      {!loading && messages.length > 0 && (
        <div className="max-h-[420px] space-y-3 overflow-y-auto pr-1">
          {messages.map(function (msg) {
            const from = getHeader(
              msg.payload
                ? msg.payload.headers
                : null,
              "From"
            );

            const date = getHeader(
              msg.payload
                ? msg.payload.headers
                : null,
              "Date"
            );

            const isFromUs =
              from
                .toLowerCase()
                .includes(
                  HELLO_EMAIL.toLowerCase()
                );

            const body =
              extractPlainText(
                msg.payload
              ) ||
              msg.snippet ||
              "";

            return (
              <div
                key={msg.id}
                className={
                  "max-w-[85%] rounded-xl border p-3 text-sm " +
                  (isFromUs
                    ? "ml-auto border-[#9e5a3c]/30 bg-[#9e5a3c]/5"
                    : "border-[#E1E1DD] bg-white")
                }
              >
                <div className="mb-1 flex items-center justify-between gap-3">
                  <span className="text-xs font-semibold text-[#171717]">
                    {isFromUs
                      ? "Cheers & Swizzles"
                      : hostName ||
                        leadEmail}
                  </span>

                  <span className="text-[10px] text-[#8A8A86]">
                    {date
                      ? new Date(
                          date
                        ).toLocaleDateString()
                      : ""}
                  </span>
                </div>

                <p className="whitespace-pre-wrap text-[#171717]">
                  {body}
                </p>
              </div>
            );
          })}
        </div>
      )}

      <div className="mt-4 space-y-2 border-t border-[#E7E7E3] pt-4">
        <Input
          value={replySubject}
          onChange={function (event) {
            setReplySubject(
              event.target.value
            );
          }}
          placeholder={
            latestMessage
              ? "Re: (auto-filled on send)"
              : "Subject"
          }
          className="h-10"
        />

        <Textarea
          value={replyBody}
          onChange={function (event) {
            setReplyBody(
              event.target.value
            );
          }}
          placeholder={
            "Reply as " +
            HELLO_EMAIL +
            "..."
          }
          className="min-h-[100px]"
        />

        <div className="flex items-center justify-between gap-3">
          <p className="text-xs text-[#8A8A86]">
            Sends from {HELLO_EMAIL} to{" "}
            {leadEmail}
          </p>

          <Button
            onClick={handleSend}
            disabled={
              sendState === "sending" ||
              !replyBody.trim()
            }
            className="h-9 bg-[#9e5a3c] px-4 text-sm font-semibold text-white hover:bg-[#8a4e33]"
          >
            {sendState === "sending" ? (
              <Loader2 className="h-4 w-4 animate-spin" />
            ) : (
              <>
                <Send className="mr-2 h-3.5 w-3.5" />
                Send
              </>
            )}
          </Button>
        </div>

        {sendState === "error" &&
          sendError && (
            <p className="text-xs text-red-600">
              {sendError}
            </p>
          )}

        {sendState === "sent" && (
          <p className="text-xs text-green-700">
            Sent.
          </p>
        )}
      </div>
    </div>
  );
}

/* =========================================================
   MAIN BLOCK
========================================================= */

export default function Block() {
  /*
   * IMPORTANT:
   *
   * The record ID comes directly from Softr's current
   * record context.
   *
   * We do NOT read the URL.
   * We do NOT search the Lead Record ID field.
   * We do NOT manually filter a list of records.
   */
  const currentRecordId =
    useCurrentRecordId();

  /*
   * useRecord() resolves the record associated with
   * the current Softr record context.
   */
  const {
    data: lead,
    status: leadStatus,
    error: leadError,
    refetch,
  } = useRecord({
    from: ds.leadForm,
    select: leadFields,
  });

  /*
   * Update hook for the current datasource.
   */
  const updateLead = useRecordUpdate({
    from: ds.leadForm,
    fields: leadUpdateFields,
  });

  /*
   * Mark the current record as Booked.
   */
  async function handlePromote(recordId) {
    if (!recordId) {
      throw new Error(
        "No current lead record ID is available."
      );
    }

    await updateLead.mutateAsync({
      recordId: recordId,
      fields: {
        leadStatus: "Booked",
      },
    });

    await refetch();
  }

  /*
   * =======================================================
   * DIAGNOSTIC STATE 1
   *
   * Softr did not supply a current record ID.
   * =======================================================
   */

  if (!currentRecordId) {
    return (
      <div className="container py-0">
        <div className="content">
          <div className="px-6 py-10">
            <div className="mx-auto max-w-3xl rounded-2xl border border-red-200 bg-red-50 p-6">
              <div className="flex items-start gap-3">
                <Info className="mt-0.5 h-5 w-5 shrink-0 text-red-600" />

                <div>
                  <p className="font-semibold text-red-800">
                    No current record supplied by Softr.
                  </p>

                  <p className="mt-2 text-sm leading-6 text-red-700">
                    This block is expecting to run in a
                    Softr record context, but
                    useCurrentRecordId() did not receive
                    a record ID.
                  </p>

                  <div className="mt-4 rounded-lg border border-red-200 bg-white p-4">
                    <p className="text-[10px] font-semibold uppercase tracking-wide text-[#8A8A86]">
                      Softr Current Record ID
                    </p>

                    <p className="mt-1 font-mono text-xs text-red-700">
                      Not available
                    </p>
                  </div>

                  <p className="mt-3 text-xs leading-5 text-red-600">
                    This is a page/navigation-context
                    issue, not a Lead Record ID field
                    lookup issue.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  }

  /*
   * =======================================================
   * DIAGNOSTIC STATE 2
   *
   * Softr supplied the ID and useRecord() is loading.
   * =======================================================
   */

  if (leadStatus === "pending") {
    return (
      <div className="container py-0">
        <div className="content">
          <div className="flex items-center justify-center gap-2 px-6 py-20 text-[#777773]">
            <Loader2 className="h-4 w-4 animate-spin" />
            Loading lead...
          </div>
        </div>
      </div>
    );
  }

  /*
   * =======================================================
   * DIAGNOSTIC STATE 3
   *
   * Softr supplied the ID but datasource failed.
   * =======================================================
   */

  if (leadStatus === "error" || leadError) {
    return (
      <div className="container py-0">
        <div className="content">
          <div className="px-6 py-10">
            <div className="mx-auto max-w-3xl rounded-2xl border border-red-200 bg-red-50 p-6">
              <div className="flex items-start gap-3">
                <Info className="mt-0.5 h-5 w-5 shrink-0 text-red-600" />

                <div className="w-full">
                  <p className="font-semibold text-red-800">
                    Record context received, but the Lead
                    record could not be loaded.
                  </p>

                  <div className="mt-4 rounded-lg border border-red-200 bg-white p-4">
                    <p className="text-[10px] font-semibold uppercase tracking-wide text-[#8A8A86]">
                      Softr Current Record ID
                    </p>

                    <p className="mt-1 break-all font-mono text-xs text-[#171717]">
                      {currentRecordId}
                    </p>
                  </div>

                  <div className="mt-3 rounded-lg border border-red-200 bg-white p-4">
                    <p className="text-[10px] font-semibold uppercase tracking-wide text-[#8A8A86]">
                      Datasource Error
                    </p>

                    <p className="mt-1 break-words text-xs text-red-700">
                      {(leadError &&
                        leadError.message) ||
                        "Unknown datasource error"}
                    </p>
                  </div>

                  <p className="mt-3 text-xs leading-5 text-red-600">
                    Navigation is supplying a record ID.
                    The problem is now isolated to
                    resolving that ID through the connected
                    Lead datasource.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  }

  /*
   * =======================================================
   * DIAGNOSTIC STATE 4
   *
   * Softr supplied the ID and useRecord() completed,
   * but no record was returned.
   * =======================================================
   */

  if (!lead) {
    return (
      <div className="container py-0">
        <div className="content">
          <div className="px-6 py-10">
            <div className="mx-auto max-w-3xl rounded-2xl border border-amber-200 bg-amber-50 p-6">
              <div className="flex items-start gap-3">
                <Info className="mt-0.5 h-5 w-5 shrink-0 text-amber-700" />

                <div className="w-full">
                  <p className="font-semibold text-amber-800">
                    Softr supplied a record ID, but no
                    Lead record was returned.
                  </p>

                  <div className="mt-4 rounded-lg border border-amber-200 bg-white p-4">
                    <p className="text-[10px] font-semibold uppercase tracking-wide text-[#8A8A86]">
                      Softr Current Record ID
                    </p>

                    <p className="mt-1 break-all font-mono text-xs text-[#171717]">
                      {currentRecordId}
                    </p>
                  </div>

                  <p className="mt-3 text-xs leading-5 text-amber-700">
                    This confirms that the page received
                    record context. The remaining issue is
                    record resolution in the connected
                    datasource.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  }

  /*
   * =======================================================
   * RECORD SUCCESSFULLY LOADED
   * =======================================================
   */

  const f = lead.fields || {};

  const leadStatusLabel =
    getValue(f.leadStatus) || "—";

  const services =
    getArrayLabels(f.services);

  const bestWayToReach =
    getArrayLabels(
      f.bestWayToReach
    ).join(", ");

  return (
    <div className="container py-0">
      <div className="content">
        <div className="px-6 py-6 sm:px-8 sm:py-10">

          {/* BACK BUTTON */}

          <button
            type="button"
            onClick={function () {
              window.history.back();
            }}
            className="mb-5 inline-flex items-center gap-2 text-sm font-medium text-[#777773] transition hover:text-[#171717]"
          >
            <ArrowLeft className="h-4 w-4" />
            Back to Leads
          </button>

          {/* HEADER */}

          <section className="mb-6 overflow-hidden rounded-2xl border border-[#E1E1DD] bg-white">
            <div className="px-6 py-8 sm:px-10">
              <div className="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p className="text-[10px] font-semibold uppercase tracking-[0.24em] text-[#8A8A86]">
                    Lead Record
                  </p>

                  <h1 className="mt-2 text-3xl font-medium tracking-[-0.03em] text-[#111111]">
                    {getValue(f.hostName) ||
                      "Unnamed lead"}
                  </h1>

                  <p className="mt-1 text-sm text-[#777773]">
                    {getValue(f.eventType) ||
                      "Event"}{" "}
                    ·{" "}
                    {getValue(
                      f.eventLocation
                    ) || "No venue"}
                  </p>
                </div>

                <StatusBadge
                  value={leadStatusLabel}
                  tone={toneForLeadStatus(
                    f.leadStatus
                  )}
                />
              </div>
            </div>
          </section>

          {/* MAIN GRID */}

          <div className="grid gap-6 lg:grid-cols-3">

            {/* LEFT */}

            <div className="space-y-6 lg:col-span-2">

              {/* LEAD DETAILS */}

              <section className="overflow-hidden rounded-2xl border border-[#E1E1DD] bg-white p-6">
                <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#9e5a3c]">
                  Details
                </p>

                <div className="mt-4 grid gap-5 sm:grid-cols-2">

                  <Field
                    label="Contact Email"
                    value={f.contactEmail}
                    icon={
                      <Mail className="h-3 w-3" />
                    }
                  />

                  <Field
                    label="Contact Phone"
                    value={f.contactPhone}
                  />

                  <Field
                    label="Event Date"
                    value={f.eventDate}
                    icon={
                      <Calendar className="h-3 w-3" />
                    }
                  />

                  <Field
                    label="Venue / Location"
                    value={f.eventLocation}
                    icon={
                      <MapPin className="h-3 w-3" />
                    }
                  />

                  <Field
                    label="Total Guests"
                    value={f.totalGuests}
                    icon={
                      <Users className="h-3 w-3" />
                    }
                  />

                  <Field
                    label="Alcohol Drinking Guests"
                    value={f.alcoholGuests}
                  />

                  <Field
                    label="Estimated Budget"
                    value={
                      getValue(
                        f.estimatedBudget
                      )
                        ? "$" +
                          getValue(
                            f.estimatedBudget
                          )
                        : ""
                    }
                    icon={
                      <DollarSign className="h-3 w-3" />
                    }
                  />

                  <Field
                    label="Best Way to Reach"
                    value={bestWayToReach}
                  />

                  <Field
                    label="Bar Service Start"
                    value={f.barStartTime}
                  />

                  <Field
                    label="Bar Service Close"
                    value={f.barCloseTime}
                  />

                  <Field
                    label="How They Heard About Us"
                    value={f.howHeard}
                  />

                  <Field
                    label="Workspace Token"
                    value={f.workspaceToken}
                  />
                </div>

                {/* SERVICES */}

                <div className="mt-5 border-t border-[#E7E7E3] pt-4">
                  <p className="text-[10px] font-semibold uppercase tracking-wide text-[#8A8A86]">
                    Services Considering
                  </p>

                  <div className="mt-2 flex flex-wrap gap-1.5">
                    {services.length === 0 && (
                      <span className="text-sm text-[#8A8A86]">
                        —
                      </span>
                    )}

                    {services.map(
                      function (service) {
                        return (
                          <StatusBadge
                            key={service}
                            value={service}
                          />
                        );
                      }
                    )}
                  </div>
                </div>

                {/* NOTES */}

                {getValue(
                  f.additionalDetails
                ) && (
                  <div className="mt-5 border-t border-[#E7E7E3] pt-4">
                    <p className="text-[10px] font-semibold uppercase tracking-wide text-[#8A8A86]">
                      Notes From Guest
                    </p>

                    <p className="mt-2 text-sm leading-6 text-[#171717]">
                      {getValue(
                        f.additionalDetails
                      )}
                    </p>
                  </div>
                )}

                {/* BEVERAGE ESTIMATES */}

                <div className="mt-5 grid grid-cols-3 gap-4 border-t border-[#E7E7E3] pt-4 text-xs text-[#8A8A86]">

                  <div>
                    <p className="uppercase tracking-wide">
                      Beer
                    </p>

                    <p className="mt-1 text-sm text-[#171717]">
                      {getValue(f.beer) ||
                        "—"}
                    </p>
                  </div>

                  <div>
                    <p className="uppercase tracking-wide">
                      Wine
                    </p>

                    <p className="mt-1 text-sm text-[#171717]">
                      {getValue(f.wine) ||
                        "—"}
                    </p>
                  </div>

                  <div>
                    <p className="uppercase tracking-wide">
                      Cocktails
                    </p>

                    <p className="mt-1 text-sm text-[#171717]">
                      {getValue(
                        f.cocktails
                      ) || "—"}
                    </p>
                  </div>

                </div>
              </section>

              {/* EMAIL */}

              <section className="overflow-hidden rounded-2xl border border-[#E1E1DD] bg-white p-6">

                <div className="mb-4 flex items-center gap-2">
                  <Mail className="h-4 w-4 text-[#9e5a3c]" />

                  <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#9e5a3c]">
                    Email Conversation
                  </p>
                </div>

                <EmailThread
                  leadEmail={getValue(
                    f.contactEmail
                  )}
                  hostName={getValue(
                    f.hostName
                  )}
                />

              </section>
            </div>

            {/* RIGHT SIDEBAR */}

            <div className="space-y-6">

              {/* PROMOTE */}

              <PromoteCard
                lead={lead}
                updateStatus={
                  updateLead.status
                }
                updateError={
                  updateLead.error
                    ? updateLead.error
                        .message
                    : ""
                }
                onPromote={
                  handlePromote
                }
              />

              {/* TRACEABILITY */}

              <section className="overflow-hidden rounded-2xl border border-[#E1E1DD] bg-white p-6">

                <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#9e5a3c]">
                  Traceability
                </p>

                <div className="mt-3 space-y-3 text-xs">

                  <div>
                    <p className="text-[#8A8A86]">
                      Softr Current Record ID
                    </p>

                    <p className="mt-0.5 break-all font-mono text-[#171717]">
                      {currentRecordId}
                    </p>
                  </div>

                  <div>
                    <p className="text-[#8A8A86]">
                      Lead Record ID
                    </p>

                    <p className="mt-0.5 break-all font-mono text-[#171717]">
                      {getValue(
                        f.leadRecordId
                      ) || "—"}
                    </p>
                  </div>

                  <div>
                    <p className="text-[#8A8A86]">
                      Reservation ID
                    </p>

                    <p className="mt-0.5 text-[#171717]">
                      {getValue(
                        f.reservationId
                      ) || "—"}
                    </p>
                  </div>

                  <button
                    type="button"
                    onClick={function () {
                      const email =
                        getValue(
                          f.contactEmail
                        );

                      if (!email) return;

                      window.open(
                        "https://mail.google.com/mail/u/0/#search/" +
                          encodeURIComponent(
                            email
                          ),
                        "_blank",
                        "noopener,noreferrer"
                      );
                    }}
                    disabled={
                      !getValue(
                        f.contactEmail
                      )
                    }
                    className="inline-flex items-center gap-1 text-[#9e5a3c] hover:underline disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    Open in Gmail
                    <ArrowUpRight className="h-3 w-3" />
                  </button>

                </div>
              </section>

            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
