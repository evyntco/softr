import React, { useMemo, useState } from "react";

import { datasource, q, useRecords } from "@/lib/datasource";
import { useNavigationSetting } from "@/lib/editable-settings";
import { NavigationAction } from "@/components/navigation-action";

import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

import {
  ChevronDown,
  ChevronRight,
  Loader2,
  Search,
  Users,
  Calendar,
  ArrowUpDown,
  ArrowUpRight,
  X,
} from "lucide-react";

const ds = datasource.define({
  leadForm: "a340adc6-d007-426c-af60-0a8b7e5121f9",
});

const leadFields = q.select({
  hostName: "Event Host Name",
  contactEmail: "Contact Email",
  contactPhone: "Contact Phone",
  eventLocation: "Event Location",
  eventDate: "Event Date",
  eventType: "Event Type",
  services: "Services you are considering that we provide",
  leadStatus: "Lead Status",
  workspaceToken: "Workspace Token",
  leadRecordId: "Lead Record ID",
  totalGuests: "Estimated Total Guest Count",
});

const SERVICE_CATEGORIES = [
  "Bartender Service for Alcoholic or Non-Alcoholic Drinks",
  "Mixers with Supplies",
  "Non-Alcoholic Drinks with Supplies",
  "Others (Champagne Toast/Table and Linens/Table Side Service/Etc)",
];

function StatusBadge({
  value,
  tone = "default",
}: {
  value: string;
  tone?: string;
}) {
  const toneClasses: Record<string, string> = {
    default: "border-[#DADAD6] bg-[#F7F7F5] text-[#555552]",
    new: "border-[#9e5a3c]/30 bg-[#9e5a3c]/10 text-[#9e5a3c]",
    warn: "border-amber-200 bg-amber-50 text-amber-800",
    good: "border-green-200 bg-green-50 text-green-800",
    danger: "border-red-200 bg-red-50 text-red-700",
  };

  return (
    <span
      className={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold ${
        toneClasses[tone] || toneClasses.default
      }`}
    >
      {value || "—"}
    </span>
  );
}

function toneForLeadStatus(status: string) {
  const s = (status || "").toLowerCase();

  if (s.includes("new")) return "new";
  if (s.includes("booked")) return "good";
  if (s.includes("estimate") || s.includes("progress")) return "warn";
  if (s.includes("lost")) return "danger";

  return "default";
}

function safeArray(value: unknown): unknown[] {
  if (!value) return [];
  if (Array.isArray(value)) return value;
  return [value];
}

function labelOf(value: unknown): string {
  return typeof value === "object" && value
    ? (value as { label?: string }).label ?? ""
    : String(value ?? "");
}

function startOfDay(d: Date) {
  const x = new Date(d);
  x.setHours(0, 0, 0, 0);
  return x;
}

function endOfDay(d: Date) {
  const x = new Date(d);
  x.setHours(23, 59, 59, 999);
  return x;
}

function getPresetRange(preset: string): [Date, Date] | null {
  const now = new Date();

  if (preset === "this_week") {
    const day = now.getDay();
    const diffToMonday = (day === 0 ? -6 : 1) - day;

    const start = startOfDay(new Date(now));
    start.setDate(now.getDate() + diffToMonday);

    const end = endOfDay(new Date(start));
    end.setDate(start.getDate() + 6);

    return [start, end];
  }

  if (preset === "this_month") {
    const start = startOfDay(
      new Date(now.getFullYear(), now.getMonth(), 1)
    );

    const end = endOfDay(
      new Date(now.getFullYear(), now.getMonth() + 1, 0)
    );

    return [start, end];
  }

  if (preset === "next_month") {
    const start = startOfDay(
      new Date(now.getFullYear(), now.getMonth() + 1, 1)
    );

    const end = endOfDay(
      new Date(now.getFullYear(), now.getMonth() + 2, 0)
    );

    return [start, end];
  }

  return null;
}

function parseLeadDate(
  str: string | undefined | null
): Date | null {
  if (!str) return null;

  const d = new Date(str);

  return Number.isNaN(d.getTime()) ? null : d;
}

export default function Block() {
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [expanded, setExpanded] = useState<Set<string>>(new Set());

  const [eventDatePreset, setEventDatePreset] =
    useState("all");

  const [customStart, setCustomStart] = useState("");
  const [customEnd, setCustomEnd] = useState("");

  const [createdStart, setCreatedStart] = useState("");
  const [createdEnd, setCreatedEnd] = useState("");

  const [serviceFilter, setServiceFilter] =
    useState<Set<string>>(new Set());

  const [sortBy, setSortBy] =
    useState("eventDate_asc");

  /*
   * IMPORTANT:
   *
   * Navigation is now handled by Softr's NavigationAction
   * using the actual datasource record ID.
   *
   * We no longer manually construct:
   *
   * /lead-record?leadRecordId=123
   *
   * Instead NavigationAction receives:
   *
   * recordId={record.id}
   *
   * This allows the destination page to receive the
   * correct record context through Softr's navigation system.
   */
  const leadRecordNavigation = useNavigationSetting({
    name: "lead-record-page",
    label: "Lead Record Page",
    initialValue: {
      action: "OPEN_PAGE",
      destination: "/lead-record",
      openIn: "SELF",
    },
  });

  const { data, status, isFetching } = useRecords({
    from: ds.leadForm,
    select: leadFields,
    count: 200,
  });

  const leads = useMemo(() => {
    return data?.pages?.flatMap((page) => page.items) || [];
  }, [data]);

  /*
   * GROUP LEADS BY WORKSPACE TOKEN
   */
  const groups = useMemo(() => {
    const map = new Map<string, typeof leads>();

    for (const lead of leads) {
      const token =
        (lead.fields?.workspaceToken as string) ||
        `untokened-${lead.id}`;

      if (!map.has(token)) {
        map.set(token, []);
      }

      map.get(token)!.push(lead);
    }

    return Array.from(map.entries()).map(
      ([token, items]) => {
        const sorted = [...items].sort(
          (a, b) =>
            new Date(b.createdTime || 0).getTime() -
            new Date(a.createdTime || 0).getTime()
        );

        return {
          token,
          items: sorted,
          latest: sorted[0],
        };
      }
    );
  }, [leads]);

  function toggleService(cat: string) {
    setServiceFilter((prev) => {
      const next = new Set(prev);

      if (next.has(cat)) {
        next.delete(cat);
      } else {
        next.add(cat);
      }

      return next;
    });
  }

  /*
   * EVENT DATE RANGE
   */
  const eventDateRange = useMemo(() => {
    if (eventDatePreset === "custom") {
      const start = customStart
        ? startOfDay(new Date(customStart))
        : null;

      const end = customEnd
        ? endOfDay(new Date(customEnd))
        : null;

      return start || end
        ? ([start, end] as [Date | null, Date | null])
        : null;
    }

    return getPresetRange(eventDatePreset);
  }, [
    eventDatePreset,
    customStart,
    customEnd,
  ]);

  /*
   * CREATED DATE RANGE
   */
  const createdRange = useMemo(() => {
    const start = createdStart
      ? startOfDay(new Date(createdStart))
      : null;

    const end = createdEnd
      ? endOfDay(new Date(createdEnd))
      : null;

    return start || end
      ? ([start, end] as [Date | null, Date | null])
      : null;
  }, [
    createdStart,
    createdEnd,
  ]);

  /*
   * FILTER + SORT
   */
  const filteredGroups = useMemo(() => {
    const term = search.trim().toLowerCase();

    let result = groups.filter((g) => {
      const f = g.latest.fields || {};

      const matchesSearch =
        !term ||
        ((f.hostName as string) || "")
          .toLowerCase()
          .includes(term) ||
        ((f.eventLocation as string) || "")
          .toLowerCase()
          .includes(term) ||
        ((f.contactEmail as string) || "")
          .toLowerCase()
          .includes(term);

      const statusLabel = labelOf(f.leadStatus);

      const matchesStatus =
        statusFilter === "all" ||
        statusLabel.toLowerCase() ===
          statusFilter.toLowerCase();

      let matchesEventDate = true;

      if (eventDateRange) {
        const [start, end] = eventDateRange;

        const eventDate = parseLeadDate(
          f.eventDate as string
        );

        matchesEventDate =
          Boolean(eventDate) &&
          (!start || eventDate! >= start) &&
          (!end || eventDate! <= end);
      }

      let matchesCreated = true;

      if (createdRange) {
        const [start, end] = createdRange;

        const created = parseLeadDate(
          g.latest.createdTime
        );

        matchesCreated =
          Boolean(created) &&
          (!start || created! >= start) &&
          (!end || created! <= end);
      }

      let matchesService = true;

      if (serviceFilter.size > 0) {
        const leadServices = safeArray(
          f.services
        ).map((s) => labelOf(s));

        matchesService = leadServices.some((s) =>
          serviceFilter.has(s)
        );
      }

      return (
        matchesSearch &&
        matchesStatus &&
        matchesEventDate &&
        matchesCreated &&
        matchesService
      );
    });

    result = [...result].sort((a, b) => {
      const fa = a.latest.fields || {};
      const fb = b.latest.fields || {};

      if (
        sortBy === "eventDate_asc" ||
        sortBy === "eventDate_desc"
      ) {
        const da = parseLeadDate(
          fa.eventDate as string
        );

        const db = parseLeadDate(
          fb.eventDate as string
        );

        if (!da && !db) return 0;
        if (!da) return 1;
        if (!db) return -1;

        return sortBy === "eventDate_asc"
          ? da.getTime() - db.getTime()
          : db.getTime() - da.getTime();
      }

      const ca = new Date(
        a.latest.createdTime || 0
      );

      const cb = new Date(
        b.latest.createdTime || 0
      );

      return sortBy === "created_desc"
        ? cb.getTime() - ca.getTime()
        : ca.getTime() - cb.getTime();
    });

    return result;
  }, [
    groups,
    search,
    statusFilter,
    eventDateRange,
    createdRange,
    serviceFilter,
    sortBy,
  ]);

  function toggleExpand(token: string) {
    setExpanded((prev) => {
      const next = new Set(prev);

      if (next.has(token)) {
        next.delete(token);
      } else {
        next.add(token);
      }

      return next;
    });
  }

  /*
   * STATUS OPTIONS
   */
  const statusOptions = useMemo(() => {
    const set = new Set<string>();

    leads.forEach((l) => {
      const val = labelOf(
        l.fields?.leadStatus
      );

      if (val) {
        set.add(val);
      }
    });

    return Array.from(set);
  }, [leads]);

  const activeFilterCount =
    (statusFilter !== "all" ? 1 : 0) +
    (eventDatePreset !== "all" ? 1 : 0) +
    (createdRange ? 1 : 0) +
    serviceFilter.size;

  function clearFilters() {
    setStatusFilter("all");
    setEventDatePreset("all");

    setCustomStart("");
    setCustomEnd("");

    setCreatedStart("");
    setCreatedEnd("");

    setServiceFilter(new Set());
  }

  /*
   * LOADING
   */
  if (status === "pending") {
    return (
      <div className="flex items-center justify-center gap-2 py-16 text-[#777773]">
        <Loader2 className="h-4 w-4 animate-spin" />
        Loading leads...
      </div>
    );
  }

  return (
    <div className="bg-[#F7F7F5] py-6 sm:py-10">
      <div className="container">
        <div className="content mx-auto max-w-6xl">

          {/* HEADER */}
          <section className="mb-6 overflow-hidden rounded-2xl border border-[#E1E1DD] bg-white">
            <div className="px-6 py-8 sm:px-10">
              <p className="text-[10px] font-semibold uppercase tracking-[0.24em] text-[#8A8A86]">
                CRUE / Evynt — Internal
              </p>

              <h1 className="mt-2 text-3xl font-medium tracking-[-0.03em] text-[#111111]">
                Leads
              </h1>

              <p className="mt-2 text-sm leading-6 text-[#777773]">
                Every pre-promotion submission, grouped by event fingerprint. Click a row to open its record.
              </p>
            </div>
          </section>

          {/* MAIN CONTENT */}
          <section className="overflow-hidden rounded-2xl border border-[#E1E1DD] bg-white p-6 sm:p-8">

            {/* SEARCH + STATUS + SORT */}
            <div className="mb-3 flex flex-col gap-3 sm:flex-row sm:items-center">

              <div className="relative flex-1">
                <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8A8A86]" />

                <Input
                  value={search}
                  onChange={(e) =>
                    setSearch(e.target.value)
                  }
                  placeholder="Search host, venue, or email..."
                  className="h-10 pl-9"
                />
              </div>

              <Select
                value={statusFilter}
                onValueChange={setStatusFilter}
              >
                <SelectTrigger className="h-10 w-full sm:w-48">
                  <SelectValue placeholder="All statuses" />
                </SelectTrigger>

                <SelectContent>
                  <SelectItem value="all">
                    All statuses
                  </SelectItem>

                  {statusOptions.map((s) => (
                    <SelectItem key={s} value={s}>
                      {s}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>

              <Select
                value={sortBy}
                onValueChange={setSortBy}
              >
                <SelectTrigger className="h-10 w-full sm:w-56">
                  <ArrowUpDown className="mr-2 h-3.5 w-3.5 text-[#8A8A86]" />

                  <SelectValue placeholder="Sort" />
                </SelectTrigger>

                <SelectContent>
                  <SelectItem value="eventDate_asc">
                    Event Date — soonest first
                  </SelectItem>

                  <SelectItem value="eventDate_desc">
                    Event Date — latest first
                  </SelectItem>

                  <SelectItem value="created_desc">
                    Lead Created — newest first
                  </SelectItem>

                  <SelectItem value="created_asc">
                    Lead Created — oldest first
                  </SelectItem>
                </SelectContent>
              </Select>
            </div>

            {/* EVENT DATE FILTER */}
            <div className="mb-3 flex flex-wrap items-center gap-2">

              <span className="flex items-center gap-1.5 text-xs font-semibold text-[#8A8A86]">
                <Calendar className="h-3.5 w-3.5" />
                Event Date
              </span>

              {[
                {
                  key: "all",
                  label: "Any time",
                },
                {
                  key: "this_week",
                  label: "This week",
                },
                {
                  key: "this_month",
                  label: "This month",
                },
                {
                  key: "next_month",
                  label: "Next month",
                },
                {
                  key: "custom",
                  label: "Custom range",
                },
              ].map((opt) => (
                <button
                  key={opt.key}
                  onClick={() =>
                    setEventDatePreset(opt.key)
                  }
                  className={`rounded-full border px-3 py-1 text-xs font-semibold transition ${
                    eventDatePreset === opt.key
                      ? "border-[#9e5a3c] bg-[#9e5a3c]/10 text-[#9e5a3c]"
                      : "border-[#DADAD6] bg-white text-[#555552] hover:border-[#BEBEB8]"
                  }`}
                >
                  {opt.label}
                </button>
              ))}

              {eventDatePreset === "custom" && (
                <div className="flex items-center gap-2">

                  <Input
                    type="date"
                    value={customStart}
                    onChange={(e) =>
                      setCustomStart(e.target.value)
                    }
                    className="h-8 w-36 text-xs"
                  />

                  <span className="text-xs text-[#8A8A86]">
                    to
                  </span>

                  <Input
                    type="date"
                    value={customEnd}
                    onChange={(e) =>
                      setCustomEnd(e.target.value)
                    }
                    className="h-8 w-36 text-xs"
                  />

                </div>
              )}
            </div>

            {/* LEAD CREATED DATE FILTER */}
            <div className="mb-3 flex flex-wrap items-center gap-2">

              <span className="text-xs font-semibold text-[#8A8A86]">
                Lead Created
              </span>

              <Input
                type="date"
                value={createdStart}
                onChange={(e) =>
                  setCreatedStart(e.target.value)
                }
                className="h-8 w-36 text-xs"
              />

              <span className="text-xs text-[#8A8A86]">
                to
              </span>

              <Input
                type="date"
                value={createdEnd}
                onChange={(e) =>
                  setCreatedEnd(e.target.value)
                }
                className="h-8 w-36 text-xs"
              />

              {(createdStart || createdEnd) && (
                <button
                  onClick={() => {
                    setCreatedStart("");
                    setCreatedEnd("");
                  }}
                  className="text-xs text-[#9e5a3c] hover:underline"
                >
                  Clear
                </button>
              )}
            </div>

            {/* SERVICE CATEGORY FILTER */}
            <div className="mb-4 flex flex-wrap items-center gap-2">

              <span className="text-xs font-semibold text-[#8A8A86]">
                Services
              </span>

              {SERVICE_CATEGORIES.map((cat) => (
                <button
                  key={cat}
                  onClick={() =>
                    toggleService(cat)
                  }
                  className={`rounded-full border px-3 py-1 text-xs font-semibold transition ${
                    serviceFilter.has(cat)
                      ? "border-[#9e5a3c] bg-[#9e5a3c]/10 text-[#9e5a3c]"
                      : "border-[#DADAD6] bg-white text-[#555552] hover:border-[#BEBEB8]"
                  }`}
                >
                  {cat.length > 28
                    ? cat.slice(0, 26) + "…"
                    : cat}
                </button>
              ))}
            </div>

            {/* CLEAR FILTERS */}
            {activeFilterCount > 0 && (
              <div className="mb-4">
                <button
                  onClick={clearFilters}
                  className="inline-flex items-center gap-1 text-xs font-semibold text-[#9e5a3c] hover:underline"
                >
                  <X className="h-3 w-3" />

                  Clear {activeFilterCount} filter
                  {activeFilterCount === 1
                    ? ""
                    : "s"}
                </button>
              </div>
            )}

            {/* COUNT */}
            <p className="mb-3 text-xs text-[#8A8A86]">
              {filteredGroups.length} event
              {filteredGroups.length === 1
                ? ""
                : "s"}{" "}
              ({leads.length} total submission
              {leads.length === 1 ? "" : "s"})

              {isFetching &&
                " · refreshing..."}
            </p>

            {/* TABLE */}
            <div className="overflow-hidden rounded-xl border border-[#E1E1DD]">

              {/* TABLE HEADER */}
              <div className="grid grid-cols-[40px_1fr_100px_80px_100px_100px_80px] bg-[#F7F7F5] text-left text-xs font-semibold uppercase tracking-wide text-[#8A8A86]">

                <div className="px-3 py-3" />

                <div className="px-3 py-3">
                  Host / Venue
                </div>

                <div className="px-3 py-3">
                  Event Date
                </div>

                <div className="px-3 py-3">
                  Guests
                </div>

                <div className="px-3 py-3">
                  Status
                </div>

                <div className="px-3 py-3">
                  Submissions
                </div>

                <div className="px-3 py-3" />

              </div>

              {/* TABLE BODY */}
              <div className="divide-y divide-[#E7E7E3]">

                {filteredGroups.map((g) => {
                  const f = g.latest.fields || {};

                  const isOpen =
                    expanded.has(g.token);

                  const statusLabel =
                    labelOf(f.leadStatus) || "—";

                  /*
                   * IMPORTANT:
                   *
                   * Use the actual datasource record ID.
                   *
                   * Do NOT use f.leadRecordId here.
                   *
                   * g.latest.id is the record ID belonging
                   * to the datasource record currently being
                   * displayed.
                   */
                  const recordId = g.latest.id;

                  return (
                    <div key={g.token}>

                      {/* MAIN ROW */}
                      <div className="grid grid-cols-[40px_1fr_100px_80px_100px_100px_80px] items-center hover:bg-[#F7F7F5]">

                        {/* EXPAND */}
                        <div className="px-3 py-3 text-[#8A8A86]">

                          {g.items.length > 1 ? (
                            <button
                              onClick={() =>
                                toggleExpand(
                                  g.token
                                )
                              }
                              className="transition-colors hover:text-[#555552]"
                            >
                              {isOpen ? (
                                <ChevronDown className="h-4 w-4" />
                              ) : (
                                <ChevronRight className="h-4 w-4" />
                              )}
                            </button>
                          ) : null}

                        </div>

                        {/* HOST / VENUE */}
                        <div className="px-3 py-3">

                          <div className="font-semibold text-[#171717]">
                            {(f.hostName as string) ||
                              "—"}
                          </div>

                          <div className="text-xs text-[#777773]">
                            {(f.eventLocation as string) ||
                              "No venue"}
                          </div>

                        </div>

                        {/* EVENT DATE */}
                        <div className="px-3 py-3 text-[#171717]">
                          {(f.eventDate as string) ||
                            "—"}
                        </div>

                        {/* GUESTS */}
                        <div className="px-3 py-3 text-[#171717]">

                          <span className="inline-flex items-center gap-1">

                            <Users className="h-3.5 w-3.5 text-[#8A8A86]" />

                            {(f.totalGuests as number) ??
                              "—"}

                          </span>

                        </div>

                        {/* STATUS */}
                        <div className="px-3 py-3">

                          <StatusBadge
                            value={statusLabel}
                            tone={toneForLeadStatus(
                              statusLabel
                            )}
                          />

                        </div>

                        {/* SUBMISSIONS */}
                        <div className="px-3 py-3 text-[#777773]">
                          {g.items.length} submission
                          {g.items.length === 1
                            ? ""
                            : "s"}
                        </div>

                        {/* OPEN */}
                        <div className="px-3 py-3 text-right">

                          {recordId ? (
                            <Button
                              size="sm"
                              className="h-7 px-2.5 text-[11px] bg-[#9e5a3c] font-semibold text-white hover:bg-[#8a4e33]"
                              asChild
                            >
                              <NavigationAction
                                navigation={
                                  leadRecordNavigation
                                }
                                recordId={recordId}
                              >
                                <span className="inline-flex items-center">
                                  Open

                                  <ArrowUpRight className="ml-1 h-3 w-3" />
                                </span>
                              </NavigationAction>
                            </Button>
                          ) : (
                            <span className="text-xs text-[#8A8A86]">
                              No ID
                            </span>
                          )}

                        </div>

                      </div>

                      {/* EXPANDED SUBMISSIONS */}
                      {isOpen &&
                        g.items.map((item) => {
                          const itemStatus =
                            labelOf(
                              item.fields?.leadStatus
                            ) || "—";

                          /*
                           * Again, use the actual datasource
                           * record ID instead of the custom
                           * Lead Record ID field.
                           */
                          const itemRecordId =
                            item.id;

                          return (
                            <div
                              key={item.id}
                              className="grid grid-cols-[40px_1fr_100px_80px_100px_100px_80px] items-center border-t border-[#EEEEEB] bg-[#FBFBFA] text-xs hover:bg-[#F5F3F0]"
                            >

                              <div />

                              {/* SERVICES */}
                              <div className="px-3 py-2 text-[#777773]">
                                {safeArray(
                                  item.fields?.services
                                )
                                  .map((s) =>
                                    labelOf(s)
                                  )
                                  .join(", ") || "—"}
                              </div>

                              {/* CONTACT */}
                              <div className="col-span-2 px-3 py-2 text-[#777773]">
                                {item.fields
                                  ?.contactEmail as string}{" "}
                                ·{" "}
                                {item.fields
                                  ?.contactPhone as string}
                              </div>

                              {/* STATUS */}
                              <div className="px-3 py-2">

                                <StatusBadge
                                  value={itemStatus}
                                  tone={toneForLeadStatus(
                                    itemStatus
                                  )}
                                />

                              </div>

                              {/* CREATED */}
                              <div className="px-3 py-2 text-[#8A8A86]">
                                {item.createdTime
                                  ? new Date(
                                      item.createdTime
                                    ).toLocaleDateString()
                                  : "—"}
                              </div>

                              {/* OPEN */}
                              <div className="px-3 py-2 text-right">

                                {itemRecordId ? (
                                  <Button
                                    size="sm"
                                    className="h-6 px-2 text-[10px] bg-[#9e5a3c] font-semibold text-white hover:bg-[#8a4e33]"
                                    asChild
                                  >
                                    <NavigationAction
                                      navigation={
                                        leadRecordNavigation
                                      }
                                      recordId={
                                        itemRecordId
                                      }
                                    >
                                      <span className="inline-flex items-center">
                                        Open

                                        <ArrowUpRight className="ml-1 h-2.5 w-2.5" />
                                      </span>
                                    </NavigationAction>
                                  </Button>
                                ) : (
                                  <span className="text-xs text-[#8A8A86]">
                                    No ID
                                  </span>
                                )}

                              </div>

                            </div>
                          );
                        })}

                    </div>
                  );
                })}

                {/* EMPTY STATE */}
                {filteredGroups.length === 0 && (
                  <div className="px-3 py-10 text-center text-[#8A8A86]">
                    No leads match this filter.
                  </div>
                )}

              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  );
}
